#
# The content store: src/content.c.  Reading an artifact through a long
# chain of deltas, turning stored content into a delta and back, content
# that arrives after it was asked for, and the commands that look for
# damage: test-integrity, test-missing, test-orphans.
#
# integrity.test damages a repository and requires the damage to be
# found.  This file covers what is left.
#

# These tests run only in a long pass: -assurance stress.
if {[test_assurance] ne "stress"} {
  test_skip "runs only with -assurance stress"
}

require_no_open_checkout

test_setup

# The answer of one SQL statement, trimmed.
#
proc content_sql {sql} {
  global RESULT
  fossil sql $sql
  return [string trim $RESULT]
}

# The record number of the artifact with the given hash.
#
proc content_rid {hash} {
  return [content_sql "SELECT rid FROM blob WHERE uuid='$hash'"]
}

# The hash that Fossil gives the content of a file.
#
proc content_hash {filename} {
  global RESULT
  fossil sha3sum $filename
  return [lindex $RESULT 0]
}

# Write a file that holds the cards $body and the Z card for them.
#
proc content_artifact {filename body} {
  global RESULT
  set fd [open $filename wb]
  puts -nonewline $fd $body
  close $fd
  fossil md5sum $filename
  set sum [lindex $RESULT 0]
  set fd [open $filename ab]
  puts -nonewline $fd "Z $sum\n"
  close $fd
}

###############################################################################
# Thirty versions of one file.  Each version but the last is stored as a
# delta from the one after it, so the first is read through 29 deltas.

set contentText ""
for {set contentI 0} {$contentI < 40} {incr contentI} {
  append contentText "line $contentI of a file that is long enough to delta\n"
}
set contentVersions {}
for {set contentI 1} {$contentI <= 30} {incr contentI} {
  append contentText "added by version $contentI\n"
  write_file long.txt $contentText
  if {$contentI == 1} {fossil add long.txt}
  fossil commit -m "content-v$contentI" --no-warnings
  lappend contentVersions $contentText
}
set contentFirst [content_sql "SELECT uuid FROM blob, mlink, event
    WHERE blob.rid=mlink.fid AND mlink.mid=event.objid
      AND event.comment='content-v1'"]
set contentLast [content_sql "SELECT uuid FROM blob, mlink, event
    WHERE blob.rid=mlink.fid AND mlink.mid=event.objid
      AND event.comment='content-v30'"]
test content-setup {$contentFirst ne "" && $contentLast ne ""}

proc content_chain {rid} {
  return [content_sql "WITH RECURSIVE c(rid,n) AS (SELECT $rid, 0
      UNION ALL SELECT srcid, n+1 FROM delta, c WHERE delta.rid=c.rid)
      SELECT max(n) FROM c"]
}
test_eq content-chain-length [content_chain [content_rid $contentFirst]] 29

fossil artifact $contentFirst first.out
test content-artifact-through-chain {$CODE == 0}
test_eq content-artifact-through-chain-text [read_file first.out] \
    [lindex $contentVersions 0]
fossil artifact $contentLast
test_eq content-artifact-to-stdout [string trim $RESULT] \
    [string trim [lindex $contentVersions end]]

fossil artifact -expectError
test content-artifact-usage {$CODE != 0}
fossil artifact no-such-artifact -expectError
test content-artifact-unknown {$CODE != 0}

###############################################################################
# The stored form of an artifact, and turning a delta back into content.

set contentRid [content_rid $contentFirst]
fossil test-content-rawget $contentFirst raw.out
test content-rawget {$CODE == 0}
test content-rawget-is-a-delta \
    {[file size raw.out] < [string length [lindex $contentVersions 0]]/2}
fossil test-content-rawget $contentFirst
test content-rawget-stdout {$CODE == 0 && $RESULT ne ""}
fossil test-content-rawget -expectError
test content-rawget-usage {$CODE != 0}

fossil test-content-undelta $contentRid
test content-undelta {$CODE == 0}
test_eq content-undelta-no-delta-row [content_sql \
    "SELECT count(*) FROM delta WHERE rid=$contentRid"] 0
fossil test-content-rawget $contentFirst raw.out
test_eq content-undelta-stored-whole [read_file raw.out] \
    [lindex $contentVersions 0]
fossil test-content-undelta $contentRid
test content-undelta-again {$CODE == 0}
fossil test-content-undelta -expectError
test content-undelta-usage {$CODE != 0}

###############################################################################
# Turning content into a delta.

set contentSecond [content_sql "SELECT blob.rid FROM blob, mlink, event
    WHERE blob.rid=mlink.fid AND mlink.mid=event.objid
      AND event.comment='content-v2'"]
set contentThird [content_sql "SELECT blob.rid FROM blob, mlink, event
    WHERE blob.rid=mlink.fid AND mlink.mid=event.objid
      AND event.comment='content-v3'"]
set contentLastRid [content_rid $contentLast]

# The artifact itself and an artifact that is a delta from it are not
# used as sources.  Of the two that remain, one is taken.
fossil test-content-deltify $contentRid $contentRid $contentLastRid \
    $contentSecond
test content-deltify {$CODE == 0}
test content-deltify-source {[content_sql "SELECT srcid FROM delta
    WHERE rid=$contentRid"] in [list $contentLastRid $contentSecond]}
fossil artifact $contentFirst first.out
test_eq content-deltify-same-content [read_file first.out] \
    [lindex $contentVersions 0]

# Already a delta: left alone without --force, done again with it.
set contentSrc [content_sql "SELECT srcid FROM delta WHERE rid=$contentRid"]
fossil test-content-deltify $contentRid $contentThird
test_eq content-deltify-not-forced [content_sql "SELECT srcid FROM delta
    WHERE rid=$contentRid"] $contentSrc
fossil test-content-deltify --force $contentRid $contentThird
test_eq content-deltify-forced [content_sql "SELECT srcid FROM delta
    WHERE rid=$contentRid"] $contentThird
fossil artifact $contentFirst first.out
test_eq content-deltify-forced-same-content [read_file first.out] \
    [lindex $contentVersions 0]

# A source that is itself a delta from the artifact, directly or not, is
# stored whole first, so that no loop is made.
fossil test-content-deltify --force $contentThird $contentLastRid
fossil test-content-deltify --force $contentThird $contentRid
test content-deltify-no-loop {$CODE == 0}
fossil artifact $contentFirst first.out
test_eq content-deltify-no-loop-content [read_file first.out] \
    [lindex $contentVersions 0]

# Content of less than 50 bytes is never made a delta, nor used as the
# source of one.
write_file small.txt "small\n"
write_file small2.txt "small too\n"
fossil test-content-put small.txt small2.txt
set contentSmall [content_rid [content_hash small.txt]]
set contentSmall2 [content_rid [content_hash small2.txt]]
fossil test-content-deltify $contentSmall $contentSmall2
test_eq content-deltify-small [content_sql "SELECT count(*) FROM delta
    WHERE rid=$contentSmall"] 0
fossil test-content-undelta $contentRid
fossil test-content-deltify $contentRid $contentSmall
test_eq content-deltify-small-source [content_sql "SELECT count(*) FROM delta
    WHERE rid=$contentRid"] 0

# Unrelated content is not worth a delta.
write_file other.txt [string repeat "nothing in common with the file\n" 40]
fossil test-content-put other.txt
fossil test-content-deltify $contentRid [content_rid [content_hash other.txt]]
test_eq content-deltify-unrelated [content_sql "SELECT count(*) FROM delta
    WHERE rid=$contentRid"] 0

# Public content is not made a delta from private content.
write_file private.txt "${contentText}and one private line\n"
fossil test-content-put private.txt
set contentPrivate [content_rid [content_hash private.txt]]
fossil sql "INSERT INTO private(rid) VALUES($contentPrivate)"
fossil test-content-deltify $contentRid $contentPrivate
test_eq content-deltify-private-source [content_sql "SELECT count(*) FROM delta
    WHERE rid=$contentRid"] 0
fossil sql "DELETE FROM private WHERE rid=$contentPrivate"
fossil test-content-deltify $contentRid $contentPrivate
test_eq content-deltify-once-public [content_sql "SELECT srcid FROM delta
    WHERE rid=$contentRid"] $contentPrivate
fossil test-content-undelta $contentRid

# Of two sources that both make a worthwhile delta, the one that makes
# the smaller is taken, whichever comes first.
set contentBase ""
for {set contentI 0} {$contentI < 60} {incr contentI} {
  append contentBase "line $contentI of content with two possible sources\n"
}
write_file two-target.txt $contentBase
write_file two-near.txt "${contentBase}one more line\n"
write_file two-far.txt "[string range $contentBase 0 1500][string repeat \
    "a line that the target does not have\n" 30]"
fossil test-content-put two-target.txt two-near.txt two-far.txt
set contentTarget [content_rid [content_hash two-target.txt]]
set contentNear [content_rid [content_hash two-near.txt]]
set contentFar [content_rid [content_hash two-far.txt]]
fossil test-content-deltify $contentTarget $contentFar $contentNear
test_eq content-deltify-better-source-last [content_sql "SELECT srcid
    FROM delta WHERE rid=$contentTarget"] $contentNear
fossil test-content-undelta $contentTarget
fossil test-content-deltify $contentTarget $contentNear $contentFar
test_eq content-deltify-better-source-first [content_sql "SELECT srcid
    FROM delta WHERE rid=$contentTarget"] $contentNear
fossil test-content-undelta $contentTarget
fossil test-content-deltify $contentTarget $contentFar
test_eq content-deltify-far-source-alone [content_sql "SELECT srcid
    FROM delta WHERE rid=$contentTarget"] $contentFar
fossil test-content-undelta $contentTarget

# Private content may be a delta from private content.
fossil sql "INSERT OR IGNORE INTO private(rid) VALUES($contentPrivate)"
fossil sql "INSERT OR IGNORE INTO private(rid) VALUES($contentRid)"
fossil test-content-deltify $contentRid $contentPrivate
test_eq content-deltify-private-from-private [content_sql "SELECT srcid
    FROM delta WHERE rid=$contentRid"] $contentPrivate
fossil test-content-undelta $contentRid
fossil sql "DELETE FROM private WHERE rid IN ($contentPrivate,$contentRid)"

fossil test-content-deltify -expectError
test content-deltify-usage {$CODE != 0}

fossil test-integrity
test content-integrity-after-deltify {$CODE == 0}

###############################################################################
# test-content-put with --moderate.

write_file moderated.txt "content awaiting moderation\n"
fossil test-content-put --moderate moderated.txt
test content-put-moderate {$CODE == 0}
test_eq content-put-moderate-row [content_sql "SELECT count(*) FROM modreq
    WHERE objid=[content_rid [content_hash moderated.txt]]"] 1

###############################################################################
# Content that arrives after it was asked for.  A check-in names a file
# that is not in the repository; when the file is stored, the check-in
# has it.  A delta manifest is stored before its baseline; when the
# baseline arrives, the delta manifest becomes a check-in.

write_file late.txt "this file arrives late\n"
set contentLate [content_hash late.txt]
content_artifact ci-late.txt "C content-late
D 2026-03-01T10:00:00.000
F late.txt $contentLate
U alice
"
fossil test-content-put --crosslink ci-late.txt
test_eq content-phantom-made [content_sql "SELECT size FROM blob
    WHERE uuid='$contentLate'"] -1
fossil artifact $contentLate
test content-phantom-has-no-content {$CODE == 0 && $RESULT eq ""}
fossil test-content-put late.txt
test_eq content-phantom-filled [content_sql "SELECT size FROM blob
    WHERE uuid='$contentLate'"] [file size late.txt]
fossil artifact $contentLate late.out
test content-phantom-filled-content {[same_file late.txt late.out]}

content_artifact ci-base.txt "C content-base
D 2026-03-02T10:00:00.000
F a.txt $contentLate
F b.txt $contentLate
U alice
"
set contentBase [content_hash ci-base.txt]
content_artifact ci-delta.txt "B $contentBase
C content-delta
D 2026-03-02T11:00:00.000
F b.txt
F c.txt $contentLate
P $contentBase
U alice
"
fossil test-content-put --crosslink ci-delta.txt
test_eq content-orphan-not-a-checkin [content_sql "SELECT count(*) FROM event
    WHERE comment='content-delta'"] 0
test_eq content-orphan-recorded [content_sql "SELECT count(*) FROM orphan"] 1
fossil test-content-put --crosslink ci-base.txt
test content-orphan-baseline-arrives {$CODE == 0}
test_eq content-orphan-now-a-checkin [content_sql "SELECT count(*) FROM event
    WHERE comment IN ('content-delta','content-base')"] 2
test_eq content-orphan-cleared [content_sql "SELECT count(*) FROM orphan"] 0
fossil ls -r [content_hash ci-delta.txt]
test_eq content-orphan-files [normalize_result] "a.txt\nc.txt"

###############################################################################
# test-integrity: the options that check the database only, and --parse
# on content that looks like an artifact and is not one.

fossil test-integrity --db-only
test_eq content-integrity-db-only [string trim $RESULT] ok
fossil test-integrity --quick
test_eq content-integrity-quick [string trim $RESULT] ok

write_file looks1.txt "C this looks like a card\nbut the rest does not\n"
write_file looks2.txt "-----BEGIN PGP SIGNED MESSAGE-----\nnot signed at all\n"
write_file looks3.txt "-----BEGIN SSH SIGNED MESSAGE-----\nnot signed either\n"
write_file looks4.txt "I am not an artifact, although I begin with a card\n"
write_file looks5.txt "D 2026-03-03T10:00:00.000\nno newline at the end"
# Content that does not begin with a card at all, content whose first line
# holds a zero byte, and content whose first line is very long.
write_file looks6.txt "1 begins with a digit, which no card does\n"
write_file looks7.txt "AB has no space after its first letter\n"
write_file looks8.txt "C a first line\x00with a zero byte in it\nand a second line\n"
write_file looks9.txt "C [string repeat x 500]\nand a second line\n"
# Content that is the first line of a signed message and nothing more,
# with no end of line.
write_file looks10.txt "-----BEGIN PGP SIGNED MESSAGE-----"
fossil test-content-put looks1.txt looks2.txt looks3.txt looks4.txt looks5.txt \
    looks6.txt looks7.txt looks8.txt looks9.txt looks10.txt
set contentLooks10 [content_hash looks10.txt]
fossil test-integrity --parse
test content-integrity-parse {$CODE == 0}
test content-integrity-parse-counts \
    {[regexp {(\d+) control artifacts failed to parse} $RESULT all n] && $n == 6}
test content-integrity-parse-one-line-signed \
    {[string first "manifest_parse failed for $contentLooks10:" $RESULT] >= 0}
test content-integrity-parse-first-line \
    {[string first "\"C this looks like a card\"" $RESULT] >= 0}

# The same content is an error once the repository has it down as a
# wiki page.
fossil sql "INSERT INTO event(type,mtime,objid,user,comment)
    VALUES('w',2461000.5,[content_rid [content_hash looks1.txt]],'alice','+x')"
fossil test-integrity --parse -expectError
test content-integrity-parse-listed-artifact {$CODE != 0}
fossil sql "DELETE FROM event
    WHERE objid=[content_rid [content_hash looks1.txt]]"

###############################################################################
# test-orphans lists content that nothing refers to.

fossil test-orphans
test content-orphans {$CODE == 0}
test content-orphans-count \
    {[regexp {(\d+) orphans} $RESULT all n] && $n >= 9}
test content-orphans-lists-one \
    {[string first [content_hash other.txt] $RESULT] >= 0}

###############################################################################
# test-missing reports each kind of reference to content that is not
# there.

fossil test-missing
test content-missing-none {$CODE == 0}
test_match content-missing-none-text $RESULT \
    {^0 missing or shunned references in \d+ control artifacts}
fossil test-missing --quiet
test_eq content-missing-none-quiet [string trim $RESULT] ""

set contentGone  [string repeat 0123456789 4]
set contentGone2 [string repeat 9876543210 4]
set contentCi [content_sql "SELECT uuid FROM blob, event
    WHERE rid=objid AND comment='content-v30'"]
foreach {contentName contentBody contentWant} [list \
  file "C content-missing-file\nD 2026-03-04T10:00:00.000\nF gone.txt $contentGone\nU alice\n" \
      "MISSING: $contentGone\n*file of check-in *\n*gone.txt" \
  parent "D 2026-03-04T11:00:00.000\nL Missing\\sparent\nP $contentGone\nU alice\nW 1\nx\n" \
      "MISSING: $contentGone\n*parent of wiki *" \
  cherrypick "C content-missing-pick\nD 2026-03-04T12:00:00.000\nP $contentCi\nQ +$contentGone $contentGone2\nU alice\n" \
      "MISSING: $contentGone\n*cherry-pick target of check-in *MISSING: $contentGone2\n*cherry-pick baseline of check-in *" \
  technote "D 2026-03-04T12:30:00.000\nE 2026-03-04T09:00:00 [string repeat ab 20]\nP $contentGone\nU alice\nW 1\nx\n" \
      "MISSING: $contentGone\n*parent of event *" \
  tag "D 2026-03-04T13:00:00.000\nT +sym-missing $contentGone\nU alice\n" \
      "MISSING: $contentGone\n*target of tag *" \
  attachment "A f.txt Missing\\sparent $contentGone\nD 2026-03-04T14:00:00.000\nU alice\n" \
      "MISSING: $contentGone\n*file of attachment *" \
  cluster "M $contentGone\nM $contentGone2\n" \
      "MISSING: $contentGone\n*in cluster *" \
] {
  content_artifact missing-$contentName.txt $contentBody
  fossil test-content-put --crosslink missing-$contentName.txt
  fossil test-missing -expectError
  test content-missing-$contentName {$CODE != 0}
  test content-missing-$contentName-text \
      {[string match "*$contentWant*" $RESULT]}
}
# An attachment that takes a file away names none, and is not counted.
content_artifact missing-detach.txt \
    "A f.txt Missing\\sparent\nD 2026-03-04T15:00:00.000\nU alice\n"
fossil test-content-put --crosslink missing-detach.txt
test content-missing-detach-stored {$CODE == 0}

fossil test-missing --quiet -expectError
test content-missing-quiet-still-reports \
    {$CODE != 0 && [string first MISSING $RESULT] >= 0}

# A missing artifact that is shunned is reported as shunned, or not at
# all with --notshunned.
fossil sql "INSERT INTO shun(uuid,mtime) VALUES('$contentGone',0),
    ('$contentGone2',0)"
fossil test-missing -expectError
test content-missing-shunned \
    {$CODE != 0 && [string first "SHUNNED: $contentGone" $RESULT] >= 0
     && [string first MISSING $RESULT] < 0}
fossil test-missing --notshunned
test content-missing-notshunned {$CODE == 0}
test_match content-missing-notshunned-text $RESULT \
    {^0 missing or shunned references}
fossil sql "DELETE FROM shun"

###############################################################################
# test-content-erase asks first.  Erasing content that others are deltas
# from stores those whole.

fossil test-content-undelta $contentRid
fossil test-content-deltify --force $contentThird $contentRid
test_eq content-erase-setup [content_sql "SELECT count(*) FROM delta
    WHERE srcid=$contentRid"] 1
fossil_raw -input "n\n" test-content-erase $contentRid
test_eq content-erase-declined [content_sql "SELECT count(*) FROM blob
    WHERE rid=$contentRid"] 1
fossil_raw -input "Y\n" test-content-erase $contentRid
test content-erase {$CODE == 0}
test_eq content-erase-gone [content_sql "SELECT count(*) FROM blob
    WHERE rid=$contentRid"] 0
test_eq content-erase-no-delta-left [content_sql "SELECT count(*) FROM delta
    WHERE srcid=$contentRid OR rid=$contentRid"] 0
fossil artifact [content_sql "SELECT uuid FROM blob WHERE rid=$contentThird"] \
    third.out
test_eq content-erase-dependent-still-whole [read_file third.out] \
    [lindex $contentVersions 2]

# The answer may be in either case.
fossil_raw -input "y\n" test-content-erase $contentSmall
test_eq content-erase-lower-case-answer [content_sql "SELECT count(*) FROM blob
    WHERE rid=$contentSmall"] 0

###############################################################################
# A "parent" tag on a private check-in is itself private, and so is the
# placeholder for a parent that the repository does not have.

content_artifact ci-private.txt "C content-private
D 2026-03-05T10:00:00.000
F late.txt $contentLate
U alice
"
fossil test-content-put --crosslink ci-private.txt
set contentPriv [content_hash ci-private.txt]
fossil sql "INSERT INTO private(rid) VALUES([content_rid $contentPriv])"
set contentAbsent [string repeat 4d 20]
fossil tag add --raw parent $contentPriv $contentAbsent
test content-private-placeholder-tag {$CODE == 0}
test_eq content-private-placeholder [content_sql "SELECT count(*)
    FROM private, blob WHERE private.rid=blob.rid AND uuid='$contentAbsent'
     AND size<0"] 1
test_eq content-private-placeholder-not-unclustered [content_sql "SELECT count(*)
    FROM unclustered, blob WHERE unclustered.rid=blob.rid
     AND uuid='$contentAbsent'"] 0
test_eq content-private-placeholder-is-parent [content_sql "SELECT count(*)
    FROM plink WHERE cid=[content_rid $contentPriv]
     AND pid=[content_rid $contentAbsent]"] 1

###############################################################################
# Content that arrives in a sync message, sent to the server side through
# "fossil test-xfer".

fossil init x.fossil
fossil sql -R x.fossil "UPDATE user SET cap='oi' WHERE login='nobody'"
fossil sql -R x.fossil "SELECT value FROM config WHERE name='project-code'"
set contentPcode [string trim $RESULT]

# Send the cards BODY as a push.  With LOGIN, the message has a login
# card, which test-xfer takes as a grant of every permission.
#
proc content_push {body {login ""}} {
  global contentPcode CLIENT_VERSION_CARD
  write_file msg.txt "$login${CLIENT_VERSION_CARD}push x $contentPcode\n$body"
  fossil_raw test-xfer -R x.fossil msg.txt
}
proc content_x {sql} {
  fossil sql -R x.fossil $sql
  return [string trim $::RESULT]
}
proc content_sha1 {text} {
  write_file sha1-me.txt $text
  fossil sha1sum sha1-me.txt
  return [lindex $::RESULT 0]
}
proc content_sha3 {text} {
  write_file sha3-me.txt $text
  fossil sha3sum sha3-me.txt
  return [lindex $::RESULT 0]
}

# A repository that holds only SHA1 names and whose hash policy is "auto"
# keeps the policy while only SHA1 names arrive, and moves to SHA3 with
# the first SHA3 name.
fossil init --sha1 y.fossil
fossil sql -R y.fossil "UPDATE user SET cap='oi' WHERE login='nobody'"
fossil hash-policy auto -R y.fossil
fossil sql -R y.fossil "SELECT value FROM config WHERE name='project-code'"
set contentYcode [string trim $RESULT]
proc content_push_y {body} {
  global contentYcode CLIENT_VERSION_CARD
  write_file msg.txt "${CLIENT_VERSION_CARD}push x $contentYcode\n$body"
  fossil_raw test-xfer -R y.fossil msg.txt
}
set contentA "an artifact with a SHA1 name\n"
content_push_y "file [content_sha1 $contentA] [string length $contentA]\n$contentA"
test content-policy-sha1-name-accepted {$CODE == 0}
fossil hash-policy -R y.fossil
test_eq content-policy-still-auto [string trim $RESULT] auto
set contentB "an artifact with a SHA3 name\n"
content_push_y "file [content_sha3 $contentB] [string length $contentB]\n$contentB"
fossil hash-policy -R y.fossil
test_eq content-policy-now-sha3 [string trim $RESULT] sha3

# An artifact that the server has only heard of is a phantom.  It is
# filled when its content arrives as a compressed delta from content the
# server holds.
set contentSrc ""
for {set contentI 0} {$contentI < 30} {incr contentI} {
  append contentSrc "line $contentI of the source of a delta\n"
}
set contentTgt "${contentSrc}and the line that the target adds\n"
set contentSrcHash [content_sha3 $contentSrc]
set contentTgtHash [content_sha3 $contentTgt]
write_file delta-src.txt $contentSrc
write_file delta-tgt.txt $contentTgt
fossil test-delta-create delta-src.txt delta-tgt.txt delta.out
set contentDelta [read_file delta.out]
set contentZ [binary format I [string length $contentDelta]][zlib compress \
    $contentDelta]
content_push "file $contentSrcHash [string length $contentSrc]\n$contentSrc"
content_push "igot $contentTgtHash\n"
test_eq content-sync-phantom [content_x "SELECT size FROM blob
    WHERE uuid='$contentTgtHash'"] -1
content_push "cfile $contentTgtHash $contentSrcHash [string length $contentTgt]\
[string length $contentZ]\n$contentZ"
test content-sync-phantom-filled-by-delta {$CODE == 0}
fossil artifact $contentTgtHash -R x.fossil tgt.out
test_eq content-sync-phantom-filled-content [read_file tgt.out] $contentTgt

# A phantom that is filled by a private card becomes private.
set contentP "content that arrives marked private\n"
set contentPHash [content_sha3 $contentP]
content_push "igot $contentPHash\n"
content_push "private\nfile $contentPHash [string length $contentP]\n$contentP" \
    "login tester 0 0\n"
test content-sync-private-fill {$CODE == 0}
test_eq content-sync-private-fill-marked [content_x "SELECT count(*)
    FROM private, blob WHERE private.rid=blob.rid AND uuid='$contentPHash'
     AND size>=0"] 1

# The server's common script asks for the record that the next artifact
# will be given, before any artifact has arrived.  An artifact that then
# arrives whole is stored and can be read at once: a delta from it, sent
# in the same message, is applied and stored whole.  An artifact that
# arrives as a compressed delta from content the server holds is stored
# and can be read.
fossil sql -R x.fossil "REPLACE INTO config(name,value,mtime)
    VALUES('xfer-common-script',
    'query {SELECT artifact_to_json((SELECT max(rid)+1 FROM blob)) AS j} {}',
    now())"
set contentQ1 "${contentSrc}the first of two that arrive together\n"
set contentQ2 "${contentQ1}and the second, sent as a delta from the first\n"
set contentQ1Hash [content_sha3 $contentQ1]
set contentQ2Hash [content_sha3 $contentQ2]
write_file q1.txt $contentQ1
write_file q2.txt $contentQ2
fossil test-delta-create q1.txt q2.txt q.delta
set contentDelta [read_file q.delta]
content_push "file $contentQ1Hash [string length $contentQ1]\n${contentQ1}file\
$contentQ2Hash $contentQ1Hash [string length $contentDelta]\n$contentDelta"
test content-sync-asked-early {$CODE == 0
    && [string first "error " $RESULT] < 0}
fossil artifact $contentQ1Hash -R x.fossil q1.out
test_eq content-sync-asked-early-content [read_file q1.out] $contentQ1
fossil artifact $contentQ2Hash -R x.fossil q2.out
test_eq content-sync-asked-early-delta-content [read_file q2.out] $contentQ2
test_eq content-sync-asked-early-delta-stored-whole [content_x "SELECT count(*)
    FROM delta, blob WHERE delta.rid=blob.rid AND uuid='$contentQ2Hash'"] 0

set contentQ3 "${contentSrc}and a line that only the third has\n"
set contentQ3Hash [content_sha3 $contentQ3]
write_file q3.txt $contentQ3
fossil test-delta-create delta-src.txt q3.txt q3.delta
set contentDelta [read_file q3.delta]
set contentZ [binary format I [string length $contentDelta]][zlib compress \
    $contentDelta]
content_push "cfile $contentQ3Hash $contentSrcHash [string length $contentQ3]\
[string length $contentZ]\n$contentZ"
test content-sync-asked-early-cfile {$CODE == 0
    && [string first "error " $RESULT] < 0}
fossil artifact $contentQ3Hash -R x.fossil q3.out
test_eq content-sync-asked-early-cfile-content [read_file q3.out] $contentQ3
test_eq content-sync-asked-early-cfile-is-delta [content_x "SELECT count(*)
    FROM delta, blob WHERE delta.rid=blob.rid AND uuid='$contentQ3Hash'"] 1
fossil sql -R x.fossil "DELETE FROM config WHERE name='xfer-common-script'"

fossil test-integrity -R x.fossil
test content-sync-integrity {$CODE == 0}

###############################################################################
# The cache of reconstructed artifacts keeps every eighth artifact along a
# delta chain and drops the oldest entry once it holds more than 2,000.
# A chain of 18,000 deltas is stored and read back in one process, so the
# cache fills and entries are dropped while the chain is read; each version
# read afterwards, through dropped and kept entries, must still be right.

fossil new cache.fossil
fossil sql -R cache.fossil {
  CREATE TEMP TABLE v(k INTEGER PRIMARY KEY, t BLOB);
  WITH RECURSIVE c(k) AS (SELECT 0 UNION ALL SELECT k+1 FROM c WHERE k<17999)
  INSERT INTO v SELECT k, CAST(printf('common text%.100c version %d', '.', k)
                               AS BLOB) FROM c;
  INSERT INTO blob(rid,rcvid,size,uuid,content)
    SELECT 100000+k, 0, length(t), printf('%064d', k),
           compress(CASE WHEN k=0 THEN t
                    ELSE delta_create((SELECT t FROM v p WHERE p.k=v.k-1), t) END)
      FROM v;
  INSERT INTO delta(rid,srcid) SELECT 100000+k, 100000+k-1 FROM v WHERE k>0;
  SELECT content('rid:117999')=(SELECT t FROM v WHERE k=17999);
  SELECT count(*) FROM v WHERE k%997=0 AND content('rid:'||(100000+k))=t;
}
test content-cache-expire {$CODE == 0}
test_eq content-cache-expire-reads [string trim $RESULT] "1\n19"

# The cache also drops its oldest entries while it holds more than 256 MB,
# as many as it takes.  Each version here is a longer prefix of one random
# text, up to 18 MB, so the oldest entries are the smallest and dropping
# one is not always enough.

fossil new cache-size.fossil
fossil sql -R cache-size.fossil {
  CREATE TEMP TABLE r(x BLOB);
  INSERT INTO r VALUES(hex(randomblob(9000000)));
  CREATE TEMP TABLE n(k INTEGER PRIMARY KEY);
  WITH RECURSIVE c(k) AS (SELECT 0 UNION ALL SELECT k+1 FROM c WHERE k<299)
  INSERT INTO n SELECT k FROM c;
  INSERT INTO blob(rid,rcvid,size,uuid,content)
    SELECT 200000+k, 0, (k+1)*60000, printf('%064d', k),
           compress(CASE WHEN k=0 THEN substr((SELECT x FROM r), 1, 60000)
                    ELSE delta_create(substr((SELECT x FROM r), 1, k*60000),
                                      substr((SELECT x FROM r), 1, (k+1)*60000))
                    END)
      FROM n;
  INSERT INTO delta(rid,srcid) SELECT 200000+k, 200000+k-1 FROM n WHERE k>0;
  SELECT content('rid:200299')
         =CAST(substr((SELECT x FROM r), 1, 300*60000) AS BLOB);
  SELECT count(*) FROM n WHERE k%37=0 AND content('rid:'||(200000+k))
         =CAST(substr((SELECT x FROM r), 1, (k+1)*60000) AS BLOB);
}
test content-cache-size {$CODE == 0}
test_eq content-cache-size-reads [string trim $RESULT] "1\n9"
file delete cache-size.fossil

# When the oldest entry is an artifact of no bytes, dropping it frees
# nothing and the cache stays over 256 MB for one more entry.  Version 7
# of this chain is empty and every other version is the same 30 MB; each
# version read afterwards must still be right.

fossil new cache-empty.fossil
fossil sql -R cache-empty.fossil {
  CREATE TEMP TABLE r(x BLOB);
  INSERT INTO r VALUES(CAST(hex(randomblob(15000000)) AS BLOB));
  CREATE TEMP TABLE d(same BLOB, toempty BLOB, fromempty BLOB);
  INSERT INTO d SELECT delta_create(x, x), delta_create(x, x''),
                       delta_create(x'', x) FROM r;
  CREATE TEMP TABLE n(k INTEGER PRIMARY KEY);
  WITH RECURSIVE c(k) AS (SELECT 0 UNION ALL SELECT k+1 FROM c WHERE k<88)
  INSERT INTO n SELECT k FROM c;
  INSERT INTO blob(rid,rcvid,size,uuid,content)
    SELECT 300000+k, 0, CASE WHEN k=7 THEN 0 ELSE 30000000 END,
           printf('%064d', k),
           compress(CASE WHEN k=0 THEN (SELECT x FROM r)
                         WHEN k=7 THEN (SELECT toempty FROM d)
                         WHEN k=8 THEN (SELECT fromempty FROM d)
                         ELSE (SELECT same FROM d) END)
      FROM n;
  INSERT INTO delta(rid,srcid) SELECT 300000+k, 300000+k-1 FROM n WHERE k>0;
  SELECT content('rid:300088')=(SELECT x FROM r);
  SELECT length(content('rid:300007'));
  SELECT count(*) FROM n WHERE k IN (6,8,15,50,87)
     AND content('rid:'||(300000+k))=(SELECT x FROM r);
}
test content-cache-empty-oldest {$CODE == 0}
test_eq content-cache-empty-oldest-reads [string trim $RESULT] "1\n0\n5"
file delete cache-empty.fossil

###############################################################################

test_cleanup
