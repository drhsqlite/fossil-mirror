unset -nocomplain extraData
array set extraData [list                     \
      0 ""                                    \
      1 Z                                     \
]


# ---------------------------------------------------------------------------
# Build cell bytes and run the assurance ladder.
# ---------------------------------------------------------------------------

proc utf_cell_bytes {i j k} {
  set payload $::bom($i)
  switch -exact $::enc($i) {
    binary {
      append payload [binary_bytes $::data($j)]
    }
    unicode-reverse {
      append payload [binary_bytes \
          [swap_byte_order [convert_to unicode $::data($j)]]]
    }
    default {
      append payload [convert_to $::enc($i) $::data($j)]
    }
  }
  append payload $::extraData($k)
  return $payload
}

proc utf_write_bytes {path bytes} {
  set f [open $path {WRONLY CREAT TRUNC}]
  fconfigure $f -translation binary
  puts -nonewline $f $bytes
  flush $f
  close $f
}

# Unsigned byte at index IDX of binary string BYTES.
proc utf_u8 {bytes idx} {
  binary scan [string index $bytes $idx] cu v
  return $v
}

# Read a native-endian ushort at byte offset OFF; if reverse, swap.
proc utf_u16 {bytes off reverse} {
  set lo [utf_u8 $bytes $off]
  set hi [utf_u8 $bytes [expr {$off+1}]]
  if {$::tcl_platform(byteOrder) eq "littleEndian"} {
    set v [expr {$lo | ($hi << 8)}]
  } else {
    set v [expr {$hi | ($lo << 8)}]
  }
  if {$reverse} {
    set v [expr {(($v << 8) & 0xff00) | (($v >> 8) & 0xff)}]
  }
  return $v
}

proc utf_starts_with_utf8_bom {bytes} {
  set n [string length $bytes]
  if {$n < 3} {return 0}
  return [expr {[utf_u8 $bytes 0]==0xef && [utf_u8 $bytes 1]==0xbb \
      && [utf_u8 $bytes 2]==0xbf}]
}

# Returns {found reverse} matching starts_with_utf16_bom.
proc utf_starts_with_utf16_bom {bytes} {
  set n [string length $bytes]
  set le [expr {$::tcl_platform(byteOrder) eq "littleEndian"}]
  if {$n < 2} {
    return [list 0 $le]
  }
  # Rule out UTF-32 BOM: UTF-16 BOM followed by 0.
  if {$n >= 4 && [utf_u8 $bytes 2]==0 && [utf_u8 $bytes 3]==0} {
    return [list 0 $le]
  }
  set i0 [utf_u16 $bytes 0 0]
  if {$i0 == 0xfeff} {
    return [list 1 0]
  }
  if {$i0 == 0xfffe} {
    return [list 1 1]
  }
  return [list 0 $le]
}

proc utf_could_be_utf16 {bytes} {
  set n [string length $bytes]
  if {$n % 2} {return [list 0 0]}
  lassign [utf_starts_with_utf16_bom $bytes] found rev
  if {!$found} {return [list 0 0]}
  return [list 1 $rev]
}

# Port of looks_like_utf8 with stopFlags==0.
proc utf_looks_like_utf8 {bytes} {
  set n [string length $bytes]
  set flags 0
  if {$n == 0} {return 0}
  set c [utf_u8 $bytes 0]
  if {$c == 0} {
    set flags [expr {$flags | 0x01}]; # LOOK_NUL
  } elseif {$c == 0x0d} {
    set flags [expr {$flags | 0x02}]; # LOOK_CR
    if {$n <= 1 || [utf_u8 $bytes 1] != 0x0a} {
      set flags [expr {$flags | 0x04}]; # LOOK_LONE_CR
    }
  }
  set j [expr {$c != 0x0a}]
  if {!$j} {
    set flags [expr {$flags | 0x08 | 0x10}]; # LOOK_LF | LOOK_LONE_LF
  }
  set rem $n
  set z 0
  while {[incr rem -1] > 0} {
    set c2 $c
    incr z
    set c [utf_u8 $bytes $z]
    incr j
    if {$c == 0} {
      set flags [expr {$flags | 0x01}]
    } elseif {$c == 0x0a} {
      set flags [expr {$flags | 0x08}]
      if {$c2 == 0x0d} {
        set flags [expr {$flags | 0x02 | 0x20}]; # CR|CRLF
      } else {
        set flags [expr {$flags | 0x10}]; # LONE_LF
      }
      if {$j > $::UTF_LENGTH_MASK} {
        set flags [expr {$flags | 0x40}]; # LONG
      }
      set j 0
    } elseif {$c == 0x0d} {
      set flags [expr {$flags | 0x02}]
      if {$rem <= 1 || [utf_u8 $bytes [expr {$z+1}]] != 0x0a} {
        set flags [expr {$flags | 0x04}]
      }
    }
  }
  if {$j > $::UTF_LENGTH_MASK} {
    set flags [expr {$flags | 0x40}]
  }
  return $flags
}

# Port of invalid_utf8 (LOOK_INVALID = 0x200), table-driven like Fossil.
proc utf_invalid_utf8 {bytes} {
  set n [string length $bytes]
  if {$n == 0} {return 0}
  # Port lb_tab ranges: for lead byte L, valid cont0 in [lo, lo+sz).
  # Only the first continuation is range-checked specially; further
  # continuations must be 80-BF.  Mirror the C bit-shift loop.
  set z 0
  set c [utf_u8 $bytes $z]
  set rem $n
  while {[incr rem -1] > 0} {
    if {$c >= 0x80} {
      set lead $c
      # c <<= 1 in C removes high bit; use lead-based ranges.
      lassign [utf_lead_range $lead] lo sz
      incr z
      set cont [utf_u8 $bytes $z]
      if {$sz == 0 || $cont < $lo || $cont >= $lo+$sz} {
        return 0x200
      }
      # Determine how many more continuation bytes (total need-1 done).
      set more 0
      if {$lead >= 0xe0 && $lead < 0xf0} {set more 1}
      if {$lead >= 0xf0 && $lead < 0xf8} {set more 2}
      if {$lead >= 0xf8} {return 0x200}
      if {$lead < 0xc0} {return 0x200}
      for {set m 0} {$m < $more} {incr m} {
        if {$rem <= 1} {
          # truncated; C would read and likely fail range
          return 0x200
        }
        incr rem -1
        incr z
        set cont [utf_u8 $bytes $z]
        if {$cont < 0x80 || $cont > 0xbf} {return 0x200}
      }
      # C: c = (c>=0xC0) ? (c|3) : ' '; then loop continues with --n
      # After a complete sequence the next lead is the following byte.
      set c 0x20
    } else {
      incr z
      set c [utf_u8 $bytes $z]
    }
  }
  return [expr {$c >= 0x80 ? 0x200 : 0}]
}

# First-continuation valid range [lo, lo+sz) for lead byte, from lb_tab.
proc utf_lead_range {lead} {
  if {$lead < 0x80} {return [list 0 0]}
  if {$lead < 0xc0} {return [list 0 0]}; # unexpected lead
  if {$lead == 0xc0} {return [list 0x80 0x01]}
  if {$lead == 0xc1} {return [list 0 0]}
  if {$lead <= 0xdf} {return [list 0x80 0x40]}
  if {$lead == 0xe0} {return [list 0xa0 0x20]}
  if {$lead <= 0xef} {return [list 0x80 0x40]}
  if {$lead == 0xf0} {return [list 0x90 0x30]}
  if {$lead <= 0xf3} {return [list 0x80 0x40]}
  if {$lead == 0xf4} {return [list 0x80 0x10]}
  return [list 0 0]
}

# Port of looks_like_utf16 with stopFlags==0.
proc utf_looks_like_utf16 {bytes reverse} {
  set n [string length $bytes]
  set flags 0
  if {$n % 2} {set flags [expr {$flags | 0x80}]; # ODD}
  if {$n < 2} {return $flags}
  set c [utf_u16 $bytes 0 $reverse]
  if {$c == 0} {
    set flags [expr {$flags | 0x01}]
  } elseif {$c == 0x0d} {
    set flags [expr {$flags | 0x02}]
    if {$n < 4 || [utf_u16 $bytes 2 $reverse] != 0x0a} {
      set flags [expr {$flags | 0x04}]
    }
  }
  set j [expr {$c != 0x0a}]
  if {!$j} {
    set flags [expr {$flags | 0x08 | 0x10}]
  }
  set rem $n
  set off 0
  while {1} {
    incr rem -2
    if {$rem < 2} break
    set c2 $c
    incr off 2
    set c [utf_u16 $bytes $off $reverse]
    incr j
    if {$c == 0} {
      set flags [expr {$flags | 0x01}]
    } elseif {$c == 0x0a} {
      set flags [expr {$flags | 0x08}]
      if {$c2 == 0x0d} {
        set flags [expr {$flags | 0x02 | 0x20}]
      } else {
        set flags [expr {$flags | 0x10}]
      }
      if {$j > $::UTF16_LENGTH_MASK} {
        set flags [expr {$flags | 0x40}]
      }
      set j 0
    } elseif {$c == 0x0d} {
      set flags [expr {$flags | 0x02}]
      if {$rem < 4 || [utf_u16 $bytes [expr {$off+2}] $reverse] != 0x0a} {
        set flags [expr {$flags | 0x04}]
      }
    }
  }
  if {$rem} {
    set flags [expr {$flags | 0x100}]; # SHORT
  }
  if {$j > $::UTF16_LENGTH_MASK} {
    set flags [expr {$flags | 0x40}]
  }
  return $flags
}

# Predict the dict of output fields for raw BYTES (path used only for size
# line).
proc utf_predict {bytes} {
  set n [string length $bytes]
  set fUtf8 [utf_starts_with_utf8_bom $bytes]
  lassign [utf_starts_with_utf16_bom $bytes] fUtf16 bRev
  lassign [utf_could_be_utf16 $bytes] fUnicode bRev2
  if {$fUnicode} {
    set bRev $bRev2
    set look [utf_looks_like_utf16 $bytes $bRev]
    set kind 16
  } else {
    set look [expr {[utf_looks_like_utf8 $bytes] | [utf_invalid_utf8 $bytes]}]
    set kind 8
  }
  set bom16 no
  if {$fUtf16} {
    set bom16 [expr {$bRev ? "reversed" : "yes"}]
  }
  set binary [expr {($look & 0x141) != 0}]; # NUL|LONG|SHORT
  dict create \
      bytes $n \
      utf8_bom [expr {$fUtf8 ? "yes" : "no"}] \
      utf16_bom $bom16 \
      looks_like [expr {$binary ? "no" : "yes"}] \
      looks_kind $kind \
      LOOK_NUL [expr {($look & 0x01) ? "yes" : "no"}] \
      LOOK_CR [expr {($look & 0x02) ? "yes" : "no"}] \
      LOOK_LONE_CR [expr {($look & 0x04) ? "yes" : "no"}] \
      LOOK_LF [expr {($look & 0x08) ? "yes" : "no"}] \
      LOOK_LONE_LF [expr {($look & 0x10) ? "yes" : "no"}] \
      LOOK_CRLF [expr {($look & 0x20) ? "yes" : "no"}] \
      LOOK_LONG [expr {($look & 0x40) ? "yes" : "no"}] \
      LOOK_INVALID [expr {($look & 0x200) ? "yes" : "no"}] \
      LOOK_ODD [expr {($look & 0x80) ? "yes" : "no"}] \
      LOOK_SHORT [expr {($look & 0x100) ? "yes" : "no"}]
}

proc utf_parse_result {text} {
  set d [dict create]
  foreach line [split [string map [list \r\n \n] $text] \n] {
    if {[regexp {^File ".*" has (\d+) bytes\.$} $line -> n]} {
      dict set d bytes $n
    } elseif {[regexp {^Starts with UTF-8 BOM: (yes|no)$} $line -> v]} {
      dict set d utf8_bom $v
    } elseif {[regexp {^Starts with UTF-16 BOM: (yes|no|reversed)$} $line -> \
        v]} {
      dict set d utf16_bom $v
    } elseif {[regexp {^Looks like UTF-(8|16): (yes|no)$} $line -> k v]} {
      dict set d looks_kind $k
      dict set d looks_like $v
    } elseif {[regexp {^Has flag (LOOK_[A-Z_]+): (yes|no)$} $line -> f v]} {
      dict set d $f $v
    }
  }
  return $d
}


# Compare every predicted field to fossil output (yes and no).
proc utf_check_cell {label bytes path} {
  utf_write_bytes $path $bytes
  set pred [utf_predict $bytes]
  fossil test-looks-like-utf $path
  set got [utf_parse_result $::RESULT]
  foreach key {bytes utf8_bom utf16_bom looks_kind looks_like \
      LOOK_NUL LOOK_CR LOOK_LONE_CR LOOK_LF LOOK_LONE_LF LOOK_CRLF \
      LOOK_LONG LOOK_INVALID LOOK_ODD LOOK_SHORT} {
    set e [dict get $pred $key]
    set a [expr {[dict exists $got $key] ? [dict get $got $key] : ""}]
    test_predict utf utf-$label-$key $a $e
  }
}

# Smoke: stratified edges covering each detector branch.
proc utf_smoke_cells {} {
  set js {
    0 1 2 3
    16 19 23 27 31
    32 48 51 64
    80 82
    128 130 132
    133 137 141
    165 181 193 197 201
  }
  set cells [list]
  foreach i {0 1 2 3} {
    foreach j $js {
      lappend cells $i $j 0
    }
    # Both extras on empty and one invalid payload.
    lappend cells $i 0 1
    lappend cells $i 133 1
  }
  return $cells
}

proc utf_all_product_cells {} {
  set cells [list]
  for {set i 0} {$i < [array size ::bom]} {incr i} {
    for {set j 0} {$j < [array size ::data]} {incr j} {
      for {set k 0} {$k < [array size ::extraData]} {incr k} {
        lappend cells $i $j $k
      }
    }
  }
  return $cells
}

# Stress-only raw payloads (no BOM/encoding wrapper): list of {label bytes}.
proc utf_stress_extras {} {
  set out [list]
  # Around long-line cutoff.
  lappend out long-32767 [string repeat A 32767]
  lappend out long-32768 [string repeat A 32768]
  lappend out long-32768-nl "[string repeat A 32768]\n"
  lappend out long-crlf "[string repeat B 32768]\r\nC"
  # Mixed control.
  lappend out nul-cr-lf "A\x00B\rC\nD\r\nE"
  lappend out crlf-nul "\r\n\x00\r\n"
  # Invalid sequences.
  lappend out inv-overlong "\xc0\x80ABC"
  lappend out inv-f5 "\xf5\x80\x80\x80"
  lappend out inv-truncated "\xe2\x82"
  lappend out inv-cont "\x80\x80\x80"
  # UTF-8 BOM plus long line.
  lappend out bom8-long "\xef\xbb\xbf[string repeat A 32768]"
  # Native UTF-16 BOM + short text (even length).
  if {$::tcl_platform(byteOrder) eq "littleEndian"} {
    set bom16 "\xff\xfe"
    set hi "\x00"
  } else {
    set bom16 "\xfe\xff"
    set hi "\x00"
  }
  set text16 ""
  foreach ch {A B C \n} {
    if {$::tcl_platform(byteOrder) eq "littleEndian"} {
      append text16 $ch $hi
    } else {
      append text16 $hi $ch
    }
  }
  lappend out utf16-abc $bom16$text16
  return $out
}

# Select cells for the current assurance level.
set level [test_assurance]
if {$level eq "smoke"} {
  set utfCells [utf_smoke_cells]
} else {
  set utfCells [utf_all_product_cells]
}

set cellN 0
foreach {i j k} $utfCells {
  set bytes [utf_cell_bytes $i $j $k]
  set path [file join $tempPath utf-cell-$i-$j-$k.jnk]
  utf_check_cell $i-$j-$k $bytes $path
  file delete $path
  incr cellN
}

if {$level eq "stress"} {
  foreach {label bytes} [utf_stress_extras] {
    set path [file join $tempPath utf-stress-$label.jnk]
    utf_check_cell stress-$label $bytes $path
    file delete $path
    incr cellN
  }
}

protOut "***** utf predictions: cells=$cellN met=$utfPredMet\
unmet=$utfPredUnmet" 1
test utf-predictions-met {$utfPredUnmet == 0}

test_cleanup
