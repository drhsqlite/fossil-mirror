#
# Tests for faults that have been fixed, which have no better home.
#

require_no_open_checkout

test_setup

write_file a.txt "a\n"
fossil add a.txt
fossil commit -m "regress-c1"

###############################################################################
# "fossil test-dir-list" on an empty directory, and on one that does not
# exist, used to crash.

file mkdir empty-directory
fossil test-dir-list empty-directory
test regress-dir-list-empty {$CODE == 0}
fossil test-dir-list no-such-directory
test regress-dir-list-missing {$CODE == 0}

###############################################################################
# "fossil test-xfer" used to print a robot captcha and then crash.

write_file request.txt $CLIENT_VERSION_CARD
fossil test-xfer request.txt
test regress-test-xfer {$CODE == 0}
test_match regress-test-xfer-reply $RESULT {# timestamp}

###############################################################################
# A branch name shorter than "date:" was read past its end when it was
# looked up.  This shows only in a build with run-time checking.

fossil branch new br trunk
fossil update br
test regress-short-branch-name {$CODE == 0}
fossil update trunk

###############################################################################
# An HTML comment or an HR tag followed by spaces and no newline made the
# Markdown translator copy one byte from past the end of its input into
# the output.  That byte was a NUL.

foreach {regressName regressText} {
  hr       "<hr>  "
  comment  "<!-- x -->  "
  quoted   "> <hr>  "
} {
  write_file md-$regressName.md $regressText
  fossil_raw test-markdown-render md-$regressName.md
  test regress-markdown-html-block-$regressName \
       {$CODE == 0 && [string first \x00 $RESULT] < 0}
}

###############################################################################
# "fossil import --svn" took the lengths in a property block from the dump
# file without checking them.  A block too short for its end marker was
# read before its start, a negative length made the import run for ever,
# and an oversized one read and wrote outside the block.

proc regress_svn_rev {number props} {
  set length [string length $props]
  set head "Revision-number: $number\nProp-content-length: $length\n"
  return "${head}Content-length: $length\n\n$props\n"
}

proc regress_svn_props {props} {
  set block ""
  foreach {name value} $props {
    append block "K [string length $name]\n$name\n"
    append block "V [string length $value]\n$value\n"
  }
  return "${block}PROPS-END\n"
}

# Each import has a time limit of 60 seconds, because one of these faults
# was an endless loop.
set regressSvnHead "SVN-fs-dump-format-version: 2\n\nUUID: 0\n\n"
foreach {regressName regressProps} {
  short-block     "abcd\n"
  negative-delete "D -6\nxxxxxxxxxxxxxxxx\nPROPS-END\n"
  oversized-key   "K 5000\nab\nV 1\nx\nPROPS-END\n"
  oversized-value "K 2\nab\nV 99999\nx\nPROPS-END\n"
  negative-value  "K 2\nab\nV -40\nx\nPROPS-END\n"
} {
  write_file svn-$regressName.dump \
      $regressSvnHead[regress_svn_rev 0 $regressProps]
  fossil_raw -seconds 60 import --svn svn-$regressName.fossil \
      svn-$regressName.dump
  test regress-svn-import-$regressName \
       {$CODE == 1 && [string match "*svn-dump data*" $RESULT]}
  file delete svn-$regressName.fossil
}

set regressSvnDate {svn:date 2026-01-01T00:00:00.000000Z}
set regressSvnSound $regressSvnHead
append regressSvnSound [regress_svn_rev 0 [regress_svn_props $regressSvnDate]]
append regressSvnSound [regress_svn_rev 1 [regress_svn_props \
    [concat {svn:log first svn:author dan} $regressSvnDate]]]
write_file svn-sound.dump $regressSvnSound
fossil import --svn svn-sound.fossil svn-sound.dump
test regress-svn-import-sound {$CODE == 0}
file delete svn-sound.fossil

###############################################################################
# Two more faults in the property block of "fossil import --svn".  A NUL
# byte in the block made the search for the end of a line fail, which
# crashed the import.  A negative length for the block itself was passed
# on as the size of an allocation.

write_file svn-nul-in-block.dump \
    $regressSvnHead[regress_svn_rev 0 "K\x00\x00\x00PROPS-END\n"]
set regressSvnNegative "Revision-number: 0\nProp-content-length: -5\n"
append regressSvnNegative "Content-length: 10\n\nPROPS-END\n\n"
write_file svn-negative-block.dump $regressSvnHead$regressSvnNegative
foreach regressName {nul-in-block negative-block} {
  fossil_raw -seconds 60 import --svn svn-$regressName.fossil \
      svn-$regressName.dump
  test regress-svn-import-$regressName \
       {$CODE == 1 && [string match "*svn-dump data format broken*" $RESULT]}
  file delete svn-$regressName.fossil
}

###############################################################################
# A Markdown header that holds an HTML comment was read past its end when
# its id was made.  This shows only in a build with run-time checking.

write_file md-header.md "intro\n\n# a <!-- -->\n"
fossil test-markdown-render md-header.md
test regress-markdown-header-comment \
     {$CODE == 0 && [string first {<h1 id="a">} $RESULT] >= 0}

###############################################################################
# The name of a file in a sibling directory, relative to the current
# directory, was copied with the length of the wrong string.  This shows
# only in a build with run-time checking.

file mkdir rel/b rel/c-with-a-longer-name/sub
fossil test-relative-name --chdir rel/b ../c-with-a-longer-name/sub/file.txt
test regress-relative-name-sibling \
     {$CODE == 0
      && [string trim $RESULT] eq "../c-with-a-longer-name/sub/file.txt"}
fossil test-relative-name --slash --chdir rel/b ../c-with-a-longer-name/sub/
test regress-relative-name-sibling-slash \
     {$CODE == 0 && [string trim $RESULT] eq "../c-with-a-longer-name/sub/"}

###############################################################################
# The names of the files in a merge conflict are put into the
# gmerge-command as they are, inside the double quotes that the setting
# has around them.  A name with a double quote reached the merge tool as
# several arguments, and one with a dollar sign or a backquote stopped the
# merge.  For such a name the tool is now left out, with a warning, and
# the conflict stays marked in the file.  The merge tool here is
# standin/log-args.sh, which records its arguments and resolves nothing.

if {$::tcl_platform(platform) ne "windows"} {
  set regressTop [pwd]
  set regressTool [test_standin log-args.sh [file join $regressTop gmerge.sh]]
  set regressToolLog [file join $regressTop gmerge-args.txt]
  set ::env(ARGS_LOG) $regressToolLog
  foreach {regressName regressFile regressRuns} {
    plain      plain.txt    1
    space      {sp ace.txt} 1
    quote      {a" "b.txt}  0
    dollar     {a$b.txt}    0
    backquote  {a`x`b.txt}  0
  } {
    file mkdir gmerge-$regressName
    cd gmerge-$regressName
    fossil init r.fossil
    fossil open r.fossil --nested
    write_file $regressFile "one\ntwo\nthree\n"
    fossil add $regressFile
    fossil commit -m base --no-warnings
    write_file $regressFile "one\nTWO-branch\nthree\n"
    fossil commit -m branch --branch br --no-warnings
    fossil update trunk
    write_file $regressFile "one\nTWO-trunk\nthree\n"
    fossil commit -m trunk --no-warnings
    fossil settings gmerge-command \
        "$regressTool \"%baseline\" \"%original\" \"%merge\" \"%output\""
    file delete $regressToolLog
    fossil_raw merge br
    set regressArgs 0
    if {[file exists $regressToolLog]} {
      set regressArgs \
          [llength [split [string trim [read_file $regressToolLog]] \n]]
    }
    set regressMarked \
        [expr {[string first "<<<<<<<" [read_file $regressFile]] >= 0}]
    set regressWarned \
        [expr {[string first "not running the gmerge-command" $RESULT] >= 0}]
    test regress-gmerge-$regressName \
         {$CODE == 0 && $regressMarked && $regressArgs == 4*$regressRuns
          && $regressWarned != $regressRuns}
    fossil close --force
    cd $regressTop
  }
  unset ::env(ARGS_LOG)
}

###############################################################################

test_cleanup
