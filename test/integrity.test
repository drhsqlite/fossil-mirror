#
# Integrity of a repository.  Two kinds of test:
#
#   * A "fossil rebuild", and a "fossil deconstruct" and "fossil
#     reconstruct" round trip, keep every artifact; "fossil
#     test-integrity" reports an artifact whose content is damaged.
#
#   * "fossil test-integrity" and "fossil test-missing" pass on a sound
#     repository and fail, with a non-zero exit status, on each of nine
#     kinds of damage made with SQL; and "fossil rebuild" leaves the
#     tables derived from the artifacts as they were, or repairs them.
#

require_no_open_checkout

test_setup ""
set ::env(FOSSIL_USER) tester

# Returns the hashes of the artifacts in repository REPO that are not
# phantoms, in order.
#
proc integrity_artifacts {repo} {
  fossil sql -R $repo "SELECT uuid FROM blob WHERE size>=0 ORDER BY uuid"
  return [normalize_result]
}

# Returns the check-ins in repository REPO with their parents and
# comments, in order of hash.
#
proc integrity_checkins {repo} {
  fossil sql -R $repo "SELECT b.uuid, coalesce(p.uuid,''), e.comment\
      FROM event e JOIN blob b ON b.rid=e.objid\
      LEFT JOIN plink ON cid=e.objid LEFT JOIN blob p ON p.rid=pid\
      WHERE e.type='ci' ORDER BY b.uuid"
  return [normalize_result]
}

# Test NAME passes when "fossil test-integrity --parse" finds no
# problems in repository REPO.
#
proc integrity_ok {name repo} {
  fossil test-integrity --parse -R $repo
  test_match $name [normalize_result] {checked: 0 errors}
}

# The tables of a repository that are derived from its artifacts, with
# each record number replaced by the hash or name it stands for and the
# rows in a fixed order.  Two repositories that hold the same artifacts
# give the same text, and so does one repository before and after a
# rebuild.
#
set integrityDerivedSql {
SELECT 'event', (SELECT uuid FROM blob WHERE rid=objid), type, mtime,
       user, euser, comment, ecomment, bgcolor, brief
  FROM event ORDER BY 2;
SELECT 'plink', (SELECT uuid FROM blob WHERE rid=pid),
       (SELECT uuid FROM blob WHERE rid=cid), isprim, mtime
  FROM plink ORDER BY 2, 3;
SELECT 'mlink', (SELECT uuid FROM blob WHERE rid=mid),
       (SELECT uuid FROM blob WHERE rid=fid),
       (SELECT uuid FROM blob WHERE rid=pid),
       (SELECT name FROM filename WHERE fnid=mlink.fnid),
       (SELECT name FROM filename WHERE fnid=mlink.pfnid), mperm, isaux
  FROM mlink ORDER BY 2, 5, 3, 4;
SELECT 'tagxref', (SELECT tagname FROM tag WHERE tagid=tagxref.tagid),
       tagtype, (SELECT uuid FROM blob WHERE rid=srcid),
       (SELECT uuid FROM blob WHERE rid=origid), value, mtime,
       (SELECT uuid FROM blob WHERE rid=tagxref.rid)
  FROM tagxref ORDER BY 2, 8, 3;
SELECT 'leaf', (SELECT uuid FROM blob WHERE rid=leaf.rid)
  FROM leaf ORDER BY 2;
SELECT 'filename', name FROM filename ORDER BY 2;
SELECT 'tag', tagname FROM tag
 WHERE tagid IN (SELECT tagid FROM tagxref) ORDER BY 2;
SELECT 'backlink', target, srctype,
       (SELECT uuid FROM blob WHERE rid=srcid), mtime
  FROM backlink ORDER BY 2, 4;
SELECT 'attachment', isLatest, mtime, src, target, filename, comment, user
  FROM attachment ORDER BY 3, 4;
}

# Returns the derived tables of repository REPO as such text.
#
proc integrity_derived {repo} {
  fossil sql -R $repo $::integrityDerivedSql
  return $::RESULT
}

# An origin repository with three check-ins of one file (so the store
# holds deltas), a tag and a wiki page.
fossil new r.fossil
file mkdir ck
cd ck
fossil open ../r.fossil
foreach {integrityFile integrityComment} \
    {a.txt one b.txt two a.txt three c.txt four} {
  write_file $integrityFile \
      "$integrityComment\n[string repeat $integrityComment 200]\n"
  fossil add $integrityFile
  fossil commit -m $integrityComment
}
fossil tag add release current
write_file ../wiki.txt "A page"
fossil wiki create Page ../wiki.txt
fossil close
cd ..
set artifacts [integrity_artifacts r.fossil]
set checkins [integrity_checkins r.fossil]
integrity_ok integrity-new r.fossil

###############################################################################
# Round trips keep every artifact.

fossil rebuild r.fossil
test integrity-rebuild {$CODE == 0}
test_eq integrity-rebuild-artifacts [integrity_artifacts r.fossil] $artifacts
test_eq integrity-rebuild-checkins [integrity_checkins r.fossil] $checkins
integrity_ok integrity-rebuild-check r.fossil

file mkdir artifacts
fossil deconstruct -R r.fossil artifacts
test integrity-deconstruct {$CODE == 0}
fossil reconstruct r2.fossil artifacts
test integrity-reconstruct {$CODE == 0}
test_eq integrity-reconstruct-artifacts [integrity_artifacts r2.fossil] \
    $artifacts
test_eq integrity-reconstruct-checkins [integrity_checkins r2.fossil] \
    $checkins
integrity_ok integrity-reconstruct-check r2.fossil

# A file artifact whose stored content does not decompress.
fossil sql -R r2.fossil "UPDATE blob SET content=x'00000010deadbeef'\
    WHERE rid=(SELECT fid FROM mlink JOIN filename USING(fnid)\
               WHERE name='b.txt' LIMIT 1)"
fossil test-integrity -R r2.fossil -expectError
test_match integrity-damaged-content [normalize_result] \
    {wrong hash on artifact \d+}
# An undamaged artifact is still readable.
fossil sql -R r2.fossil "SELECT uuid FROM blob JOIN mlink ON fid=rid\
    JOIN filename USING(fnid) WHERE name='c.txt'"
fossil artifact [normalize_result] -R r2.fossil
test_eq integrity-artifact-readable [normalize_result] \
    "four\n[string repeat four 200]"

###############################################################################
# test-integrity and test-missing: exit 0 on a sound repository, non-zero
# on each kind of damage.  Each kind is made to a copy.

fossil sql -R r.fossil "SELECT count(*) FROM delta"
test integrity-has-deltas {$RESULT > 0}
fossil test-integrity --parse -R r.fossil
test integrity-sound {$CODE == 0}
fossil test-missing -R r.fossil
test integrity-nothing-missing {$CODE == 0}

# A file of a check-in that is neither a delta nor the source of one.
set integrityOneFile "(SELECT fid FROM mlink WHERE fid>0\
  AND fid NOT IN (SELECT srcid FROM delta)\
  AND fid NOT IN (SELECT rid FROM delta) LIMIT 1)"

foreach {integrityName integritySql integrityCmd} [list \
  wrong-size \
    "UPDATE blob SET size=size+1 WHERE rid=$integrityOneFile" \
    test-integrity \
  content-does-not-match-hash \
    "UPDATE blob SET content=x'0102030405060708' WHERE rid=$integrityOneFile" \
    test-integrity \
  hash-does-not-match-content \
    "UPDATE blob SET uuid=substr(uuid,1,length(uuid)-1) ||\
     CASE substr(uuid,-1) WHEN '0' THEN '1' ELSE '0' END\
     WHERE rid=$integrityOneFile" \
    test-integrity \
  delta-is-its-own-source \
    "UPDATE delta SET srcid=rid WHERE rid=(SELECT rid FROM delta LIMIT 1)" \
    test-integrity \
  delta-source-gone \
    "DELETE FROM blob WHERE rid=(SELECT srcid FROM delta LIMIT 1)" \
    test-integrity \
  public-delta-from-private \
    "INSERT INTO private SELECT srcid FROM delta LIMIT 1" \
    test-integrity \
  checkin-is-not-a-manifest \
    "UPDATE blob\
     SET content=(SELECT content FROM blob WHERE rid=$integrityOneFile)\
     WHERE rid=(SELECT max(objid) FROM event WHERE type='ci')" \
    {test-integrity --parse} \
  file-gone \
    "DELETE FROM blob WHERE rid=$integrityOneFile" \
    test-missing \
  file-is-a-phantom \
    "UPDATE blob SET size=-1, content=NULL WHERE rid=$integrityOneFile" \
    test-missing \
] {
  set integrityDamaged [file join [pwd] damaged.fossil]
  file copy -force r.fossil $integrityDamaged
  fossil sql -R $integrityDamaged $integritySql
  fossil {*}$integrityCmd -R $integrityDamaged -expectError
  test integrity-damage-$integrityName {$CODE != 0}
}

###############################################################################
# Rebuild leaves the derived tables alone, or repairs a wrong one.

set integrityBefore [integrity_derived r.fossil]
test integrity-derived-not-empty {[string length $integrityBefore] > 0}
fossil rebuild r.fossil
test_eq integrity-rebuild-same [integrity_derived r.fossil] $integrityBefore

file copy -force r.fossil $integrityDamaged
fossil sql -R $integrityDamaged \
  "DELETE FROM plink WHERE rowid=(SELECT max(rowid) FROM plink)"
test integrity-missing-parent-link-shows \
  {[integrity_derived $integrityDamaged] ne $integrityBefore}
fossil rebuild $integrityDamaged
test_eq integrity-rebuild-repairs [integrity_derived $integrityDamaged] \
    $integrityBefore

test_cleanup
unset ::env(FOSSIL_USER)
