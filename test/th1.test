###############################################################################

th1_cases {
  th1-string-first-1 {string first {} {}} -1
  th1-string-first-2 {string first {} {a}} -1
  th1-string-first-3 {string first {a} {}} -1
  th1-string-first-4 {string first {a} {a}} 0
  th1-string-first-5 {string first {a} {aa}} 0
  th1-string-first-6 {string first {aa} {a}} -1
  th1-string-first-7 {string first {ab} {abc}} 0
  th1-string-first-8 {string first {bc} {abc}} 1
  th1-string-first-9 {string first {AB} {abc}} -1
  th1-string-last-1 {string last {} {}} -1
  th1-string-last-2 {string last {} {a}} -1
  th1-string-last-3 {string last {a} {}} -1
  th1-string-last-4 {string last {a} {a}} 0
  th1-string-last-5 {string last {a} {aa}} 1
  th1-string-last-6 {string last {aa} {a}} -1
  th1-string-last-7 {string last {ab} {abc}} 0
  th1-string-last-8 {string last {bc} {abc}} 1
  th1-string-last-9 {string last {AB} {abc}} -1
}

###############################################################################

th1_cases {
  th1-expr-1 {expr -2147483649.0} -2147483649.0
  th1-expr-2 {expr -2147483649} 2147483647
  th1-expr-3 {expr -2147483648} -2147483648
  th1-expr-4 {expr -2147483647} -2147483647
  th1-expr-5 {expr -1} -1
  th1-expr-6 {expr 0} 0
  th1-expr-7 {expr 0.0} 0.0
  th1-expr-8 {expr 1} 1
  th1-expr-9 {expr 2147483647} 2147483647
  th1-expr-10 {expr 2147483648} 2147483648
  th1-expr-11 {expr 2147483649} 2147483649
  th1-expr-12 {expr +2147483649} -2147483647
  th1-expr-13 {expr +2147483649.0} 2147483649.0
  th1-expr-14 {expr ~(-1)} 0
  th1-expr-15 {expr ~-1} 0
  th1-expr-16 {expr ~0} -1
  th1-expr-17 {expr ~+0} -1
  th1-expr-18 {expr ~-0} -1
  th1-expr-19 {expr ~(+0)} -1
  th1-expr-20 {expr ~(-0)} -1
  th1-expr-21 {expr ~1} -2
  th1-expr-22 {expr ~+1} -2
  th1-expr-23 {expr ~(+1)} -2
  th1-expr-24 {expr 0+0b11} 3
  th1-expr-25 {expr 0+0o15} 13
  th1-expr-26 {expr 0+0x15} 21
  th1-expr-27 {expr 0+0b2} {TH_ERROR: expected number, got: "0b2"}
  th1-expr-28 {expr 0+0o8} {TH_ERROR: expected number, got: "0o8"}
  th1-expr-29 {expr 0+0xg} {TH_ERROR: syntax error in expression: "0+0xg"}
  th1-expr-30 {expr 0+0b1.} {TH_ERROR: syntax error in expression: "0+0b1."}
  th1-expr-31 {expr 0+0o1.} {TH_ERROR: syntax error in expression: "0+0o1."}
  th1-expr-32 {expr 0+0x1.} {TH_ERROR: syntax error in expression: "0+0x1."}
  th1-expr-33 {expr 0ne5} 1
  th1-expr-34 {expr 0b1+5} 6
  th1-expr-35 {expr 0+0b} {TH_ERROR: expected number, got: "0b"}
  th1-expr-36 {expr (-1)+1} 0
  th1-expr-37 {expr (((-1)))} -1
  th1-expr-38 {expr (((1)))} 1
  th1-expr-39 {expr (((1))} {TH_ERROR: syntax error in expression: "(((1))"}
  th1-expr-40 {expr ((1)))} {TH_ERROR: syntax error in expression: "((1)))"}
  th1-expr-41 {expr (((1)*2)*2)} 4
  th1-expr-42 {expr +} {TH_ERROR: syntax error in expression: "+"}
  th1-expr-43 {expr -} {TH_ERROR: syntax error in expression: "-"}
  th1-expr-44 {expr ++} {TH_ERROR: syntax error in expression: "++"}
  th1-expr-45 {expr --} {TH_ERROR: syntax error in expression: "--"}
  th1-lindex-bad-1 {lindex list +} {TH_ERROR: expected integer, got: "+"}
  th1-lindex-bad-2 {lindex list -} {TH_ERROR: expected integer, got: "-"}
  th1-lindex-bad-3 {lindex list +0x} {TH_ERROR: expected integer, got: "+0x"}
  th1-lindex-bad-4 {lindex list -0x} {TH_ERROR: expected integer, got: "-0x"}
}

###############################################################################

# NOTE: The 'd' permission is no longer used.  Skip "reader" (u) and
# "developer" (v) meta-permissions.
set th1_cap_perms {
  a b c e f g h i j k l m n o p q r s t w x y z
  A D
  2 3 4 5 6 7
}

set cases {}
foreach perm $th1_cap_perms {
  lappend cases th1-anycap-no-$perm-1 "anycap $perm" 0
  lappend cases th1-hascap-no-$perm-1 "hascap $perm" 0
  lappend cases th1-anoncap-no-$perm-1 "anoncap $perm" 0
}
lappend cases \
  th1-anycap-no-multiple-1 {anycap oh} 0 \
  th1-hascap-no-multiple-1 {hascap oh} 0 \
  th1-hascap-no-multiple-2 {hascap o h} 0 \
  th1-anoncap-no-multiple-1 {anoncap oh} 0 \
  th1-anoncap-no-multiple-2 {anoncap o h} 0
th1_cases $cases

###############################################################################

set skip_anycap 1
if {$::outside_fossil_repo} {
  test_skip_part "th1-anycap-*-1 perm tests: not in Fossil repo checkout."
} elseif {$::dirty_ckout} {
  test_skip_part "th1-anycap-*-1 perm tests: uncommitted changes in\
Fossil checkout."
} else {
  set skip_anycap 0
}

if {!$skip_anycap} {
  run_in_checkout {
    set cases {}
    foreach perm $th1_cap_perms {
      lappend cases th1-anycap-yes-$perm-1 "anycap $perm" 1
      lappend cases th1-hascap-yes-$perm-1 "hascap $perm" 1
    }
    lappend cases \
      th1-anycap-yes-multiple-1 {anycap oh} 1 \
      th1-hascap-yes-multiple-1 {hascap oh} 1 \
      th1-hascap-yes-multiple-2 {hascap o h} 1
    set ::env(TH1_TEST_USER_CAPS) sxy
    th1_cases --set-user-caps $cases

    set cases {}
    foreach perm $th1_cap_perms {
      lappend cases th1-anycap-no-$perm-2 "anycap $perm" 0
      lappend cases th1-hascap-no-$perm-2 "hascap $perm" 0
    }
    set ::env(TH1_TEST_USER_CAPS) 1; # NOTE: Bad permission.
    th1_cases --set-user-caps $cases

    set ::env(TH1_TEST_USER_CAPS) o
    th1_cases --set-user-caps {
      th1-anycap-yes-multiple-2 {anycap oh} 1
      th1-hascap-no-multiple-3 {hascap oh} 0
      th1-hascap-no-multiple-4 {hascap o h} 0
    }
    unset ::env(TH1_TEST_USER_CAPS)

    set cases {}
    foreach perm $th1_cap_perms {
      lappend cases th1-anoncap-yes-$perm-1 "anoncap $perm" 1
    }
    lappend cases \
      th1-anoncap-yes-multiple-1 {anoncap oh} 1 \
      th1-anoncap-yes-multiple-2 {anoncap o h} 1
    set ::env(TH1_TEST_ANON_CAPS) sxy
    th1_cases --set-anon-caps $cases

    set cases {}
    foreach perm $th1_cap_perms {
      lappend cases th1-anoncap-no-$perm-2 "anoncap $perm" 0
    }
    set ::env(TH1_TEST_ANON_CAPS) 1; # NOTE: Bad permission.
    th1_cases --set-anon-caps $cases

    set ::env(TH1_TEST_ANON_CAPS) o
    th1_cases --set-anon-caps {
      th1-anoncap-no-multiple-3 {anoncap oh} 0
      th1-anoncap-no-multiple-4 {anoncap o h} 0
    }
    unset ::env(TH1_TEST_ANON_CAPS)
  }
}

###############################################################################

test_in_checkout th1-checkout-1 {
  # NOTE: The "1" here forces the checkout to be opened.
  fossil test-th-eval "checkout 1"
} {[string length $RESULT] > 0}

###############################################################################

test_in_checkout th1-checkout-2 {
  if {$th1Hooks} {
    fossil test-th-eval "checkout"
  } else {
    # NOTE: No TH1 hooks, force checkout to be populated.
    fossil test-th-eval --open-config "checkout"
  }
} {[string length $RESULT] > 0}

