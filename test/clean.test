############################################################################
#
# Tests of the "clean" command, including the ability to undo it.
#

test_setup

###############################################################################

fossil extra
test_eq clean-0 [normalize_result] {}

###############################################################################

commit_file f1 "f1 line" "base file"
fossil ls
test_eq clean-1 [normalize_result] {f1}

###############################################################################

fossil extra
test_eq clean-2 [normalize_result] {}

###############################################################################

write_file f2 "f2 line"
fossil extra
test_eq clean-3 [normalize_result] {f2}

###############################################################################

# clean w/undo enabled, should not prompt, 1 file < 10MiB
fossil clean
test clean-4 {[normalize_result] eq \
{"fossil undo" is available to undo changes to the working checkout.}}

###############################################################################

fossil extra
test_eq clean-5 [normalize_result] {}

###############################################################################

fossil undo
test_eq clean-6 [normalize_result] {NEW    f2}
test_eq clean-7 [read_file f2] "f2 line"

###############################################################################

fossil extra
test_eq clean-8 [normalize_result] {f2}

###############################################################################

write_file f3 [string repeat ABCDEFGHIJK 1048576]
fossil extra
test_eq clean-9 [normalize_result] \
    {f2
f3}

###############################################################################

# clean w/undo enabled, no prompt, 1 file < 10MiB, 1 file > 10MiB
fossil clean --no-prompt
test clean-10 {[normalize_result] eq \
{"fossil undo" is available to undo changes to the working checkout.}}

###############################################################################

fossil extra
test_eq clean-11 [normalize_result] {f3}

###############################################################################

fossil undo
test_eq clean-12 [normalize_result] {NEW    f2}
test_eq clean-13 [read_file f2] "f2 line"
test_eq clean-14 [read_file f3] [string repeat ABCDEFGHIJK 1048576]

###############################################################################

fossil extra
test_eq clean-15 [normalize_result] \
    {f2
f3}

###############################################################################

# clean w/undo enabled, force, 1 file < 10MiB, 1 file > 10MiB
fossil clean --force
test clean-16 {[normalize_result] eq \
{"fossil undo" is available to undo changes to the working checkout.}}

###############################################################################

fossil extra
test_eq clean-17 [normalize_result] {}

###############################################################################

fossil undo
test_eq clean-18 [normalize_result] {NEW    f2}
test_eq clean-19 [read_file f2] "f2 line"

###############################################################################

write_file f4 [string repeat KJIHGFEDCBA 1048576]
fossil extra
test_eq clean-20 [normalize_result] \
    {f2
f4}

###############################################################################

# clean w/undo disabled, no prompt, 1 file < 10MiB, 1 file > 10MiB
fossil clean --disable-undo --no-prompt
test_eq clean-21 [normalize_result] {}

###############################################################################

fossil extra
test_eq clean-22 [normalize_result] \
    {f2
f4}

###############################################################################

fossil undo -expectError
test_eq clean-23 [normalize_result] {nothing to undo}

###############################################################################

# clean w/undo disabled, force, 1 file < 10MiB, 1 file > 10MiB
fossil clean --disable-undo --force
test_eq clean-24 [normalize_result] {}

###############################################################################

fossil extra
test_eq clean-25 [normalize_result] {}

###############################################################################

fossil undo -expectError
test_eq clean-26 [normalize_result] {nothing to undo}

###############################################################################

write_file f5 "f5 line"
fossil extra
test_eq clean-27 [normalize_result] {f5}

###############################################################################

# clean w/undo disabled, should prompt, 1 file < 10MiB
fossil_maybe_answer Y clean --disable-undo
test clean-28 {[normalize_result] eq \
{WARNING: Deletion of this file will not be undoable via the 'undo'
         command because undo is disabled for this operation.

Remove unmanaged file "f5" (a=all/y/N)?}}

###############################################################################

fossil extra
test_eq clean-29 [normalize_result] {}

###############################################################################

fossil undo -expectError
test_eq clean-30 [normalize_result] {nothing to undo}

###############################################################################

fossil extra
test_eq clean-31 [normalize_result] {}

###############################################################################

test_cleanup
