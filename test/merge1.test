############################################################################
#
# Tests of the 3-way merge
#

test_setup ""

# Merges V1 and V2, two versions of BASE, and tests that the result is
# EXPECTED.  ARGS are more arguments for "fossil 3-way-merge".
#
proc merge1_case {name base v1 v2 expected args} {
  write_file_indented t1 $base
  write_file_indented t2 $v1
  write_file_indented t3 $v2
  write_file_indented expected $expected
  fossil 3-way-merge t1 t2 t3 merged {*}$args
  test $name {[same_file expected merged]}
}

set merge1Base {
  111 - This is line one of the demo program - 1111
  222 - The second line program line in code - 2222
  333 - This is a test of the merging algohm - 3333
  444 - If all goes well, we will be pleased - 4444
  555 - we think it well and other stuff too - 5555
}
set merge1G1T3 {
  111 - This is line one of the demo program - 1111
  222 - The second line program line in code - 2222
  333 - This is a test OF THE merging algohm - 3333
  444 - If all goes well, we will be pleased - 4444
  555 - we think it well and other stuff too - 5555
}
set merge1G1T2 {
  111 - This is line ONE of the demo program - 1111
  222 - The second line program line in code - 2222
  333 - This is a test of the merging algohm - 3333
  444 - If all goes well, we will be pleased - 4444
  555 - we think it well and other stuff too - 5555
}
set merge1G1T23 {
  111 - This is line ONE of the demo program - 1111
  222 - The second line program line in code - 2222
  333 - This is a test OF THE merging algohm - 3333
  444 - If all goes well, we will be pleased - 4444
  555 - we think it well and other stuff too - 5555
}
merge1_case merge1-1.1 $merge1Base $merge1G1T3 $merge1G1T2 $merge1G1T23
merge1_case merge1-1.2 $merge1Base $merge1G1T2 $merge1G1T3 $merge1G1T23

