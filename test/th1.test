############################################################################
#
# TH1 Commands
#

set path [file dirname [info script]]; test_setup

###############################################################################

set th1Tcl [is_tcl_usable_by_fossil]
set th1Hooks [are_th1_hooks_usable_by_fossil]

# Evaluate TH1 case triples {name body expected ...}.  catch restores the
# TH_ERROR: prefix that test-th-eval prints for a top-level error.
#
proc th1_cases {args} {
  set opts {}
  while {[llength $args] > 0 && [string match -* [lindex $args 0]]} {
    lappend opts [lindex $args 0]
    set args [lrange $args 1 end]
  }
  if {[llength $args] != 1} {
    error "th1_cases ?options? {name body expected ...}"
  }
  set cases [lindex $args 0]
  if {[llength $cases] % 3} {
    error "th1_cases: cases must be name body expected triples"
  }
  set script "set out {}\n"
  set names {}
  set expecteds {}
  foreach {name body expected} $cases {
    lappend names $name
    lappend expecteds $expected
    append script "set rc \[catch [list $body] msg\]\n"
    append script "if {\$rc} {\n"
    append script "  lappend out \"TH_ERROR: \$msg\"\n"
    append script "} else {\n"
    append script "  lappend out \$msg\n"
    append script "}\n"
  }
  append script "set out"
  fossil test-th-eval {*}$opts $script
  set results [normalize_result]
  if {[llength $results] != [llength $names]} {
    test [lindex $names 0] {0}
    return
  }
  foreach name $names expected $expecteds actual $results {
    test_eq $name $actual $expected
  }
}

###############################################################################

th1_cases --open-config {
  th1-setting-1 {setting abc} {}
  th1-setting-2 {setting -- abc} {}
  th1-setting-3 {setting -strict abc} {TH_ERROR: no value for setting "abc"}
  th1-setting-4 {setting -strict -- abc} {TH_ERROR: no value for setting "abc"}
}

###############################################################################

fossil test-th-eval --open-config "setting autosync"
test th1-setting-5 {$RESULT eq 0 || $RESULT eq 1 || $RESULT eq "on"}

###############################################################################

fossil test-th-eval --open-config "setting -strict autosync"
test th1-setting-6 {$RESULT eq 0 || $RESULT eq 1 || $RESULT eq "on"}

###############################################################################

th1_cases --open-config {
  th1-setting-7 {setting --} \
      {TH_ERROR: wrong # args: should be "setting ?-strict? ?--? name"}
  th1-setting-8 {setting -strict --} \
      {TH_ERROR: wrong # args: should be "setting ?-strict? ?--? name"}
  th1-setting-9 {setting -- --} {}
  th1-setting-10 {setting -strict -- --} {TH_ERROR: no value for setting "--"}
}

###############################################################################

th1_cases {
  th1-divide-by-zero-1 {expr 42/0} {TH_ERROR: Divide by 0: 42}
  th1-divide-by-zero-2 {expr 42/0.0} {TH_ERROR: Divide by 0: 42}
  th1-divide-by-zero-3 {expr 42.0/0} {TH_ERROR: Divide by 0: 42.0}
  th1-divide-by-zero-4 {expr 42.0/0.0} {TH_ERROR: Divide by 0: 42.0}
  th1-modulus-by-zero-1 {expr 42%0} {TH_ERROR: Modulo by 0: 42}
  th1-modulus-by-zero-2 {expr 42%0.0} {TH_ERROR: expected integer, got: "0.0"}
  th1-modulus-by-zero-3 {expr 42.0%0} {TH_ERROR: expected integer, got: "42.0"}
  th1-modulus-by-zero-4 {expr 42.0%0.0} {TH_ERROR: expected integer, got: "42.0"}
}

