############################################################################
#
# Pathnames that differ in letter case, or that write the same
# characters with different code points: the Unicode normalization
# forms NFC, with one code point for an accented letter, and NFD, with
# the letter followed by a combining mark.
#
# With the case-sensitive setting on, fossil compares pathnames byte
# for byte, so each spelling is a different file.  With the setting
# off, two pathnames are the same file when they are a canonical
# caseless match (the Unicode Standard, section 3.13, definition D145):
# equal after canonical decomposition and case folding.  A file system
# that ignores case and normalization has one file for both names.
#
# The harness classifies the temporary volume once at startup
# (::fs_type).  This file predicts match, miss, or untestable from
# that classification, Fossil argv rewriting, and the rules above.
# -assurance selects how many pairs to run: smoke (one per
# behavior class), ci (the lists below), or stress (ci plus generated
# pairs).  Unmet predictions fail the run.
#
# Case folding maps both the sharp s, U+00DF, and the capital sharp s,
# U+1E9E, to the two letters "ss", so by D145 a name with a sharp s and
# the same name with "ss" are one file.  ext4 with case folding folds
# each sharp s to "ss" and has one file for the two names.  NTFS and
# HFS+ convert each character to one character, and have two files.
# Collide tests require two names on disk, so they are skipped when
# ::fs_type says this volume has one entry for the pair.
#

require_no_open_checkout

# Fossil reads the pathnames on its command line, and Tcl reads
# fossil's output, in the system encoding.
#
set upSavedEncoding [encoding system]
encoding system utf-8

set upPredMet 0
set upPredUnmet 0

# Returns NAME with each character outside ASCII written as a Tcl
# escape, so that two spellings that look the same can be distinguished.
#
proc up_escape {name} {
  set escaped ""
  foreach char [split $name ""] {
    scan $char %c code
    if {$code > 126} {
      append escaped [format {\u%04x} $code]
    } else {
      append escaped $char
    }
  }
  return $escaped
}

# Prints the two spellings of the pair LABEL before the tests of that
# pair, each unescaped and with escapes.
#
proc up_show {label a b} {
  protOut "unicode-pathnames $label: $a ([up_escape $a]) and\
      $b ([up_escape $b])"
}

# Returns the hash of the check-in that the last "fossil commit" made.
#
proc up_new_version {} {
  regexp {New_Version: ([0-9a-f]+)} $::RESULT -> hash
  return $hash
}

# Which ::fs_type key governs whether this volume stores A and B as one
# directory entry.  Case-only pairs use ascii_case; NFC/NFD and
# compatibility decompositions use normalization; sharp-s uses sharp_s.
#
proc up_fs_key {label} {
  switch -exact -- $label {
    sharp-s - capital-sharp-s - stress-sharp {
      return sharp_s
    }
    nfd - nfd-case - nfd-dir - marks - kana - arabic - angstrom -
    hangul - han-compat - devanagari - stress-nfd {
      return normalization
    }
    default {
      return ascii_case
    }
  }
}

# Return 1 when ::fs_type says this volume has one directory entry for
# the two spellings of LABEL.
#
proc up_fs_collides {label} {
  return [dict get $::fs_type [up_fs_key $label]]
}

# Return 1 when fossil test-echo rewrites B to the checked-in spelling A.
#
proc up_argv_maps {a b} {
  fossil test-echo $b
  return [expr {[string first "argv\[2\] = \[$a\]" $::RESULT] >= 0}]
}


# Each row is a label, the pathname that is checked in, and another
# spelling that is a D145 caseless match (or treated as one file in
# the header for compatibility pairs).
#
set upSameAll [list \
  ascii      readme.txt        README.TXT \
  ascii-dir  dir/notes.txt     DIR/Notes.TXT \
  latin      "\u00e4rger.txt"  "\u00c4RGER.TXT" \
  greek      "\u03b1\u03c1\u03c7\u03b5\u03af\u03bf.txt" \
             "\u0391\u03a1\u03a7\u0395\u038a\u039f.TXT" \
  cyrillic   "\u0444\u0430\u0439\u043b.txt" \
             "\u0424\u0410\u0419\u041b.TXT" \
  sigma      "\u03bf\u03b4\u03cc\u03c2.txt" \
             "\u039f\u0394\u038c\u03a3.TXT" \
  nfd        "r\u00e9sum\u00e9.txt"  "re\u0301sume\u0301.txt" \
  nfd-case   "cr\u00e8me.txt"  "CRE\u0300ME.TXT" \
  marks      "\u1ead.txt"      "a\u0323\u0302.txt" \
  angstrom   "\u00e5.txt"      "\u212b.TXT" \
  hangul     "\ud55c\uae00.txt" \
             "\u1112\u1161\u11ab\u1100\u1173\u11af.txt" \
  nfd-dir    "caf\u00e9/menu.txt"  "CAFE\u0301/MENU.TXT" \
  sharp-s    "stra\u00dfe.txt"  "STRASSE.TXT" \
  capital-sharp-s  "gro\u00df.txt"  "GRO\u1e9e.TXT" \
  han        "\u4e2d\u6587.txt"  "\u4e2d\u6587.TXT" \
  han-compat "\u8c48.txt"      "\uf900.txt" \
  kana       "\u30ac\u30d1.txt" \
             "\u30ab\u3099\u30cf\u309a.txt" \
  fullwidth  "\uff46\uff49\uff4c\uff45.txt" \
             "\uff26\uff29\uff2c\uff25.TXT" \
  arabic     "\u0623\u062d\u0645\u062f.txt" \
             "\u0627\u0654\u062d\u0645\u062f.txt" \
  devanagari "\u0915\u093c.txt"  "\u0958.txt" \
]

# Each row is a label, the pathname that is checked in, and a pathname
# that is a different file with the setting on or off.
#
set upDifferentAll [list \
  accent       "expos\u00e9.txt"    expose.txt \
  other-mark   "\u00e5ngstr.txt"    "\u00e4ngstr.txt" \
  superscript  "x\u00b2.txt"        x2.txt \
  han-variant  "\u6a94\u6848.txt"   "\u6863\u6848.txt" \
  kana-script  "\u304b\u306a.txt"   "\u30ab\u30ca.txt" \
  fullwidth-ascii  "\uff41\uff42.txt"  ab.txt \
]

set upCollideAll [list \
  ascii     readme.txt             README.TXT \
  latin     "\u00e4rger.txt"       "\u00c4RGER.TXT" \
  nfd       "r\u00e9sum\u00e9.txt" "re\u0301sume\u0301.txt" \
  nfd-case  "cr\u00e8me.txt"       "CRE\u0300ME.TXT" \
  sharp-s   "stra\u00dfe.txt"      "STRASSE.TXT" \
]

# Smoke: one pair per behavior class.
set upSmokeSame {ascii latin sigma nfd sharp-s han-compat}
set upSmokeDifferent {accent}
set upSmokeCollide {ascii}

# Stress-only pairs (not in the ci lists).
set upStressSame [list \
  stress-latin  "\u00f6ffentlich.txt"  "\u00d6FFENTLICH.TXT" \
  stress-nfd    "na\u00efve.txt"       "nai\u0308ve.txt" \
  stress-sharp  "gro\u00dfartig.txt"   "GROSSARTIG.TXT" \
]
set upStressDifferent [list \
  stress-miss   "caf\u00e9.txt"        cafe.txt \
]
set upStressCollide [list \
  stress-latin  "\u00f6ffentlich.txt"  "\u00d6FFENTLICH.TXT" \
  stress-nfd    "na\u00efve.txt"       "nai\u0308ve.txt" \
]

# Build the pair lists for the current -assurance level.
#
proc up_select {all smokeLabels} {
  set level [test_assurance]
  if {$level eq "smoke"} {
    set out [list]
    foreach {label a b} $all {
      if {$label in $smokeLabels} {
        lappend out $label $a $b
      }
    }
    return $out
  }
  return $all
}

set upSame [up_select $upSameAll $upSmokeSame]
set upDifferent [up_select $upDifferentAll $upSmokeDifferent]
set upCollide [up_select $upCollideAll $upSmokeCollide]

if {[test_assurance] eq "stress"} {
  foreach {label a b} $upStressSame {
    lappend upSame $label $a $b
  }
  foreach {label a b} $upStressDifferent {
    lappend upDifferent $label $a $b
  }
  foreach {label a b} $upStressCollide {
    lappend upCollide $label $a $b
  }
}

###############################################################################
#
# One spelling of each pathname is checked in and on disk.  Fossil is
# then given the other spelling.
#
test_setup
fossil settings case-sensitive 1

set upNames [list]
foreach {label a b} $upSame {
  file mkdir [file dirname $a]
  write_file $a "$label\n"
  lappend upNames $a
}
foreach {label a b} $upDifferent {
  write_file $a "$label\n"
  lappend upNames $a
}
fossil add {*}$upNames
fossil commit -m "one spelling of each pathname"

fossil ls
test_eq unicode-pathnames-ls [lsort [split [normalize_result] \n]] \
    [lsort $upNames]

# upConverted lists pairs whose other spelling fossil rewrites to the
# checked-in name when it reads its arguments.
#
set upConverted [list]
foreach {label a b} $upSame {
  if {[up_argv_maps $a $b]} {
    lappend upConverted $label
  }
}

# With the setting on, the other spelling is not a file under
# management, unless fossil converts it.  Positive: converted pairs
# find the file.  Negative: unconverted pairs do not.
#
foreach {label a b} $upSame {
  up_show $label $a $b
  set converted [expr {$label in $upConverted}]
  fossil ls $b
  test_predict up unicode-pathnames-on-$label-ls [normalize_result] \
      [expr {$converted ? $a : ""}]
  fossil cat $b {*}[expr {$converted ? "" : "-expectError"}]
  test_predict up unicode-pathnames-on-$label-cat $CODE [expr {!$converted}]
}

# With the setting off, D145 matches must be found by the other
# spelling; upDifferent pairs must not.
#
fossil settings case-sensitive 0

foreach {label a b} $upSame {
  up_show $label $a $b
  fossil ls $b
  test_predict up unicode-pathnames-off-$label-ls [normalize_result] $a
  fossil cat $b
  test_predict up unicode-pathnames-off-$label-cat-code $CODE 0
  test_predict up unicode-pathnames-off-$label-cat [normalize_result] $label
  fossil rm --soft -n $b
  test_predict up unicode-pathnames-off-$label-rm [normalize_result] \
      "DELETED $a"
}

foreach {label a b} $upDifferent {
  up_show $label $a $b
  fossil ls $b
  test_predict up unicode-pathnames-off-$label-ls [normalize_result] ""
  fossil cat $b -expectError
  test_predict up unicode-pathnames-off-$label-cat $CODE 1
  fossil rm --soft -n $b
  test_predict up unicode-pathnames-off-$label-rm [normalize_result] ""
}

# A file on disk under the other spelling is not an extra file, and
# "fossil add" does not add it.  Needs a volume that stores two names.
#
set upOneFile [list]
foreach {label a b} $upSame {
  up_show $label $a $b
  if {[up_fs_collides $label] || $label in $upConverted} {
    lappend upOneFile $label
    continue
  }
  # Confirm the working tree still has two distinct entries.
  if {[file exists $b]} {
    lappend upOneFile $label
    continue
  }
  file mkdir [file dirname $b]
  write_file $b "other spelling\n"
  fossil extras
  test_predict up unicode-pathnames-off-$label-extras [normalize_result] ""
  fossil add $b
  fossil changes
  test_predict up unicode-pathnames-off-$label-add [normalize_result] ""
  fossil revert
  file delete $b
  if {[file dirname $b] ne "."} {
    catch {file delete [file dirname $b]}
  }
}
if {[llength $upOneFile] > 0} {
  test_skip_part "extras and add tests of [join $upOneFile {, }]:\
      filesystem type or argv rewriting has one name for both spellings\
      (fs_type: $::fs_type)"
}

###############################################################################
#
# A version made with the setting on has both spellings of a pathname.
# With the setting off, fossil must refuse to commit from a check-out of
# that version and refuse to update to it, because a file system that
# has one file for both names would give both the same content.
#
set upOneFile [list]
foreach {label a b} $upCollide {
  up_show $label $a $b
  test_setup
  fossil settings case-sensitive 1
  write_file $a "first spelling\n"
  write_file plain.txt "plain\n"
  fossil add $a plain.txt
  fossil commit -m "first spelling"
  set upFirst [up_new_version]
  set converted [up_argv_maps $a $b]
  if {$converted} {
    lappend upConverted $label
  }
  if {[up_fs_collides $label] || $converted || [file exists $b]} {
    lappend upOneFile $label
    continue
  }
  write_file $b "second spelling\n"
  fossil add $b
  fossil commit -m "second spelling"
  set upBoth [up_new_version]

  fossil settings case-sensitive 0
  write_file plain.txt "edited\n"
  fossil commit -m "edit plain.txt" -expectError
  test_predict up unicode-pathnames-collide-$label-commit $CODE 1

  fossil settings case-sensitive 1
  fossil revert
  fossil update $upFirst
  fossil settings case-sensitive 0
  fossil update $upBoth -expectError
  test_predict up unicode-pathnames-collide-$label-update $CODE 1
  test_predict up unicode-pathnames-collide-$label-update-file \
      [file exists $b] 0
}
if {[llength $upOneFile] > 0} {
  test_skip_part "commit and update tests of [join $upOneFile {, }]:\
      filesystem type or argv rewriting has one name for both spellings\
      (fs_type: $::fs_type)"
}

###############################################################################

protOut "***** unicode-pathnames predictions:\
met=$upPredMet unmet=$upPredUnmet"
test unicode-pathnames-predictions-met {$upPredUnmet == 0}

encoding system $upSavedEncoding
test_cleanup
