fossil settings robot-restrict off
fossil test-th-eval --open-config "styleHeader {Page Title Here}"
test th1-header-2 {[regexp -- \
    {<title>Unnamed Fossil Project: Page Title Here</title>} $RESULT]}
fossil unset robot-restrict

