############################################################################
#
# Test UTF-8/UTF-16 detection via fossil test-looks-like-utf.
#
# -assurance selects how many cells to run: smoke (stratified
# edges), ci (full BOM x payload x extra product), or stress (ci plus
# generated payloads).  Expectations come from a Tcl predictor over
# the bytes written, not from a fossil-echo dump.  Each LOOK_*/BOM
# line is checked for both yes and no.
#

test_setup ""

set utfPredMet 0
set utfPredUnmet 0

# Same as LENGTH_MASK in src/diff.c: (1<<15)-1.
set UTF_LENGTH_MASK 32767
# UTF16_LENGTH_MASK: LENGTH_MASK_SZ - (sizeof(WCHAR_T)-1) => 14 bits.
set UTF16_LENGTH_MASK 16383

proc swap_byte_order {str} {
  set result ""
  for {set i 0} {$i < [string length $str]} {incr i} {
    set c [scan [string index $str $i] %c]
    set c [expr {(($c << 8) & 0xFF00) | (($c >> 8) & 0xFF)}]
    append result [format %c $c]
  }
  return $result
}

# Returns S converted to the encoding ENC.  Tcl 9 refuses an unpaired
# surrogate unless the conversion uses the tcl8 profile, which Tcl 8 does
# not have.
proc convert_to {enc s} {
  if {[package vsatisfies [package provide Tcl] 9-]} {
    return [encoding convertto -profile tcl8 $enc $s]
  }
  return [encoding convertto $enc $s]
}

# Returns the bytes that Tcl 8 writes for S to a channel in the binary
# encoding: the low byte of each UTF-16 unit.  Tcl 9 does not have the
# binary encoding.
proc binary_bytes {s} {
  if {![package vsatisfies [package provide Tcl] 9-]} {
    return $s
  }
  set format [expr {$::tcl_platform(byteOrder) eq "littleEndian" ? "s*" : "S*"}]
  binary scan [convert_to unicode $s] $format units
  return [binary format c* $units]
}

unset -nocomplain enc
array set enc [list     \
      0 binary          \
      1 binary          \
      2 unicode         \
      3 unicode-reverse \
]

unset -nocomplain bom
array set bom [list                                         \
      0 ""                                                  \
      1 \xEF\xBB\xBF                                        \
      2 [expr {$tcl_platform(byteOrder) eq "littleEndian" ? \
            "\xFF\xFE" : "\xFE\xFF"}]                       \
      3 [expr {$tcl_platform(byteOrder) eq "littleEndian" ? \
            "\xFE\xFF" : "\xFF\xFE"}]                       \
]

