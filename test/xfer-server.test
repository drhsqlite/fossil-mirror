#
# Each kind of card and pragma of the sync protocol, sent to the server
# side through "fossil test-xfer", with and without valid card
# permissions.  The server must give the documented answer and must not
# crash.  xfer-cards.test has the cards with content.
#
# "fossil test-xfer" treats a login card as a grant of the Read, Write,
# Private and Admin permissions.  A message without a login card runs
# with the permissions of the user "nobody", which these tests set.
#

require_no_open_checkout

test_setup

write_file a.txt "hello world\n"
fossil add a.txt
fossil commit -m one --no-warnings
fossil sha3sum a.txt
set xferserverFile [lindex $RESULT 0]
fossil sql -R .rep.fossil "SELECT value FROM config WHERE name='project-code'"
set xferserverPcode [string trim $::RESULT]
fossil sql -R .rep.fossil "SELECT max(rid) FROM blob"
set xferserverMaxRid [string trim $::RESULT]

# The server is a copy of the repository of this checkout, so that it
# holds a check-in.  A hash that it does not hold:
file copy .rep.fossil srv.fossil
set xferserverAbsent [string repeat 0123456789abcdef 4]

set xferserverLogin "login tester 0 0\n"
set xferserverPull "pull x $xferserverPcode\n"
set xferserverPush "push x $xferserverPcode\n"

proc xferserver_caps {caps} {
  fossil sql -R srv.fossil \
    "UPDATE user SET cap='$caps' WHERE login IN ('nobody','anonymous')"
}

proc xferserver_set {name value} {
  fossil sql -R srv.fossil \
    "REPLACE INTO config(name,value,mtime) VALUES('$name','$value',now())"
}

proc xferserver_unset {pattern} {
  fossil sql -R srv.fossil "DELETE FROM config WHERE name GLOB '$pattern'"
}

# Returns the number of rows on the server that "SELECT count(*) FROM"
# finds, with FROM as the remainder of the query.
proc xferserver_count {from} {
  fossil sql -R srv.fossil "SELECT count(*) FROM $from"
  return [string trim $::RESULT]
}

# Returns 1 if the server holds the artifact HASH, or a phantom for it,
# and has it marked private.
proc xferserver_private {hash} {
  return [xferserver_count \
      "blob b, private p WHERE p.rid=b.rid AND b.uuid='$hash'"]
}

# Send the message BODY to the server.  Sets RESULT to the reply, as
# bytes because it can hold compressed content, and CODE to the exit
# status of fossil.
proc xferserver_send {body} {
  write_file msg.txt $body
  fossil_raw test-xfer -R srv.fossil msg.txt
}

# Send the message BODY.  Test NAME passes when fossil exits with status
# 0 and the reply holds each of the strings given.  A string that begins
# with "!" must be absent.
proc xferserver_expect {name body args} {
  xferserver_send $body
  test xfer-server-$name {$::CODE == 0 && [holds_strings $::RESULT $args]}
}

# The message with which the client CLIENT asks for the lock on the
# check-in CKIN.
proc xferserver_lock {ckin client} {
  global xferserverLogin xferserverPull
  return "$xferserverLogin${xferserverPull}pragma ci-lock $ckin $client\n"
}

###############################################################################
# With no permissions at all, everything is refused.

xferserver_caps ""
xferserver_expect none-pull $xferserverPull \
    {error not\sauthorized\sto\sread}
xferserver_expect none-push $xferserverPush \
    {error not\sauthorized\sto\swrite}
xferserver_expect none-clone "clone 3 1\n" \
    {error not\sauthorized\sto\sclone}
xferserver_expect none-file "file $xferserverFile 12\nhello world\n" \
    {error not\sauthorized\sto\swrite}
xferserver_expect none-cfile "cfile $xferserverFile 12 3\nabc\n" \
    {error not\sauthorized\sto\swrite}
xferserver_expect none-uvgimme "uvgimme note.txt\n" "!uvfile" "errors 0"
xferserver_expect none-reqconfig "reqconfig /project\n" "!config " "errors 0"
xferserver_expect none-uv-hash "pragma uv-hash $xferserverAbsent\n" \
    "!uv-pull-only" "!uv-push-ok"
xferserver_expect none-private "private\n" \
    {error not\sauthorized\sto\ssync\sprivate}
xferserver_expect none-send-private "pragma send-private\n" \
    {error not\sauthorized\sto\ssync\sprivate}
xferserver_expect none-config "config /project 0\n\n" \
    {error not\sauthorized\sto\spush\sconfiguration}

###############################################################################
# Read only: a pull is served, a push after it is turned into a message.

xferserver_caps "o"
xferserver_expect read-pull $CLIENT_VERSION_CARD$xferserverPull \
    "igot " "pragma server-version" "errors 0"
xferserver_expect read-pull-then-push $xferserverPull$xferserverPush \
    {message pull\sonly\s-\snot\sauthorized\sto\spush}
xferserver_expect read-gimme \
    "$CLIENT_VERSION_CARD${xferserverPull}gimme $xferserverFile\n" \
    "file $xferserverFile"
# A client that gives no version is taken to be older than 2.0, which
# cannot be sent a SHA3 hash.
xferserver_expect read-gimme-old-client \
    "${xferserverPull}gimme $xferserverFile\n" \
    "!file $xferserverFile" {error Fossil\sversion\s2.0\sor\slater\srequired}
xferserver_expect read-gimme-absent \
    "${xferserverPull}gimme $xferserverAbsent\n" \
    "!file $xferserverAbsent" "errors 0"
xferserver_expect read-gimme-no-pull "gimme $xferserverFile\n" \
    "!file $xferserverFile" "errors 0"
xferserver_expect read-igot-no-push \
    "${xferserverPull}igot $xferserverAbsent\n" \
    "!gimme $xferserverAbsent" "errors 0"
xferserver_expect read-uv-hash "pragma uv-hash $xferserverAbsent\n" \
    "pragma uv-pull-only"
xferserver_expect read-reqconfig "reqconfig /project\n" "config /config "
xferserver_expect read-reqconfig-old-style "reqconfig project-name\n" \
    "!config " "errors 0"

###############################################################################
# Malformed cards are answered with "bad command", or with an error of
# their own, and never crash.

foreach {xferserverName xferserverBody} [list \
  gimme-extra-token   "gimme $xferserverFile extra\n" \
  gimme-not-a-hash    "gimme nothash\n" \
  uvgimme-extra-token "uvgimme a b\n" \
  uvgimme-bad-name    "uvgimme ../etc/passwd\n" \
  igot-alone          "igot\n" \
  igot-not-a-hash     "igot nothash\n" \
  pull-not-a-hash     "pull x nothash\n" \
  pull-too-few        "pull x\n" \
  login-too-few       "login tester 0\n" \
  reqconfig-extra     "reqconfig /project extra\n" \
  config-size-not-int "config /project notint\n" \
  cookie-alone        "cookie\n" \
  pragma-alone        "pragma\n" \
  unknown-card        "frobnicate 1 2 3\n" \
] {
  xferserver_expect bad-$xferserverName $xferserverBody {error bad\scommand:}
}
xferserver_expect wrong-project "pull x $xferserverAbsent\n" \
    {error wrong\sproject}
xferserver_expect cookie "cookie abc\n" "errors 0"
xferserver_expect unknown-pragma "pragma no-such-pragma 1 2\n" "errors 0"
xferserver_expect comment-line "# a comment\n$xferserverPull" "errors 0"
xferserver_expect ci-lock-too-few "pragma ci-lock $xferserverFile\n" "errors 0"
xferserver_expect ci-unlock-not-a-hash "pragma ci-unlock nothash\n" "errors 0"
xferserver_expect client-version-short "pragma client-version 22900\n" \
    "!pragma server-version" "errors 0"

###############################################################################
# Write without Private: a client that says an artifact is private is not
# asked for it, and may not send private content.

xferserver_caps "io"
xferserver_expect write-igot-public \
    "${xferserverPush}igot $xferserverAbsent\n" \
    "gimme $xferserverAbsent"
test xfer-server-write-igot-public-not-private \
    {[xferserver_private $xferserverAbsent] == 0}
xferserver_expect write-igot-private-known \
    "${xferserverPush}igot $xferserverAbsent 1\n" \
    "!gimme $xferserverAbsent" "errors 0"
test xfer-server-write-igot-private-marks-phantom \
    {[xferserver_private $xferserverAbsent] == 1}
set xferserverUnknown [string repeat fedcba9876543210 4]
xferserver_expect write-igot-private-unknown \
    "${xferserverPush}igot $xferserverUnknown 1\n" \
    "!gimme $xferserverUnknown" "errors 0"
test xfer-server-write-igot-private-unknown-not-stored \
    {[xferserver_count "blob WHERE uuid='$xferserverUnknown'"] == 0}
xferserver_expect write-private "${xferserverPush}private\n" \
    {error not\sauthorized\sto\ssync\sprivate}
xferserver_expect write-client-url \
    "${xferserverPush}pragma client-url http://example.org/x\n" "errors 0"
test xfer-server-write-client-url-recorded \
    {[xferserver_count \
        "config WHERE name GLOB 'syncfrom:*example.org*'"] == 1}

###############################################################################
# With a login card: private content, configuration, clone and locks.

xferserver_caps ""
# A private artifact that the server does not have becomes a private
# phantom.  It is asked for only when the client offers to send private
# content.
set xferserverPhantom [string repeat 00112233445566778899aabbccddeeff 2]
xferserver_expect login-igot-private \
    "$xferserverLogin${xferserverPush}igot $xferserverPhantom 1\n" \
    "!gimme $xferserverPhantom" "errors 0"
test xfer-server-login-igot-private-phantom \
    {[xferserver_private $xferserverPhantom] == 1}
xferserver_expect login-private "$xferserverLogin${xferserverPush}private\n" \
    "errors 0"
xferserver_expect login-send-private \
    "$xferserverLogin${xferserverPull}pragma send-private\n" "errors 0"
xferserver_expect login-send-catalog \
    "$xferserverLogin${xferserverPull}pragma send-catalog\n" \
    "igot $xferserverFile"
xferserver_expect login-req-clusters \
    "$xferserverLogin${xferserverPull}pragma req-clusters\n" "errors 0"
xferserver_expect login-req-links \
    "$xferserverLogin${xferserverPull}pragma req-links\n" "errors 0"
# The hash is that of the empty string under SHA1.
xferserver_expect login-uv-hash-same \
    "${xferserverLogin}pragma uv-hash\
     da39a3ee5e6b4b0d3255bfef95601890afd80709\n" \
    "!uv-pull-only" "!uv-push-ok"

xferserver_send "${xferserverLogin}reqconfig /project\n"
test xfer-server-login-reqconfig \
    {$CODE == 0 && [string first "config /config " $RESULT] >= 0}
set xferserverCards ""
foreach xferserverLine [split $RESULT \n] {
  if {[string match "#*" $xferserverLine]} continue
  append xferserverCards $xferserverLine\n
}
xferserver_expect login-config-roundtrip \
    "$xferserverLogin$xferserverPush$xferserverCards" "errors 0"
xferserver_expect login-config-negative-size \
    "${xferserverLogin}config /project -5\n" {error bad\scommand:}

# Clone, in each version of the protocol.  A login card to test-xfer does
# not grant the Clone permission, so "nobody" is given it and these
# messages have no login card.
xferserver_caps "g"
xferserver_expect clone-v2-old-client "clone 2 1\n" \
    "!file " {error Fossil\sversion\s2.0\sor\slater\srequired} "clone_seqno 0"
xferserver_expect clone-v3-old-client "clone 3 1\n" \
    "!cfile " {error Fossil\sversion\s2.0\sor\slater\srequired} "clone_seqno 0"
xferserver_expect clone-v1 "${CLIENT_VERSION_CARD}clone\n" \
    "push " "igot $xferserverFile" "errors 0"
xferserver_expect clone-v1-odd-arguments "${CLIENT_VERSION_CARD}clone x y\n" \
    "push " "errors 0"
xferserver_expect clone-v2 "${CLIENT_VERSION_CARD}clone 2 1\n" \
    "file " "clone_seqno 0"
xferserver_expect clone-v3 "${CLIENT_VERSION_CARD}clone 3 1\n" \
    "cfile " "clone_seqno 0" "errors 0"
xferserver_expect clone-v3-past-end \
    "${CLIENT_VERSION_CARD}clone 3 [expr {$xferserverMaxRid+50}]\n" \
    "!cfile " "clone_seqno 0"
xferserver_expect clone-v3-zero "${CLIENT_VERSION_CARD}clone 3 0\n" \
    {error invalid\sclone\ssequence\snumber}
xferserver_set max-download 1
xferserver_expect clone-v3-small-reply "${CLIENT_VERSION_CARD}clone 3 1\n" \
    "!cfile " "clone_seqno 1"
xferserver_unset max-download
xferserver_set max-download-time 0
xferserver_expect clone-v3-no-time "${CLIENT_VERSION_CARD}clone 3 1\n" "cfile "
xferserver_unset max-download-time
xferserver_set uv-sync 1
xferserver_expect clone-uv-sync "${CLIENT_VERSION_CARD}clone 3 1\n" \
    "pragma uv-pull-only"
xferserver_unset uv-sync
xferserver_caps ""

# Check-in locks.  The second client to ask for the lock on the same
# check-in is told who holds it; the holder asking again is not.
fossil sql -R srv.fossil "SELECT uuid FROM blob WHERE rid=(SELECT max(objid)\
   FROM event WHERE type='ci')"
set xferserverCkin [string trim $::RESULT]
set xferserverClientA [string repeat a 40]
set xferserverClientB [string repeat b 40]
xferserver_expect ci-lock-first \
    [xferserver_lock $xferserverCkin $xferserverClientA] \
    "!ci-lock-fail" "pragma avoid-delta-manifests"
xferserver_expect ci-lock-holder-again \
    [xferserver_lock $xferserverCkin $xferserverClientA] "!ci-lock-fail"
xferserver_expect ci-lock-second-client \
    [xferserver_lock $xferserverCkin $xferserverClientB] "pragma ci-lock-fail "
xferserver_expect ci-unlock \
    "$xferserverLogin${xferserverPull}pragma ci-unlock $xferserverClientA\n" \
    "errors 0"
test xfer-server-ci-unlock-removed \
    {[xferserver_count "config WHERE name GLOB 'ci-lock-*'"] == 0}
xferserver_expect ci-lock-after-unlock \
    [xferserver_lock $xferserverCkin $xferserverClientB] "!ci-lock-fail"
fossil sql -R srv.fossil \
    "UPDATE config SET mtime=mtime-100000 WHERE name GLOB 'ci-lock-*'"
xferserver_expect ci-lock-expired \
    [xferserver_lock $xferserverCkin $xferserverClientA] "!ci-lock-fail"
xferserver_set forbid-delta-manifests 0
xferserver_expect ci-lock-delta-manifests-allowed \
    [xferserver_lock $xferserverCkin $xferserverClientA] \
    "!avoid-delta-manifests" "errors 0"

###############################################################################
# More cards and pragmas under particular permissions and settings.

xferserver_unset ci-lock-*
xferserver_unset forbid-delta-manifests
# An igot card with a flag of 0 offers a public artifact.
set xferserverPublic [string repeat 0f1e2d3c4b5a6978 4]
xferserver_expect login-igot-flag-zero \
    "$xferserverLogin${xferserverPush}igot $xferserverPublic 0\n" \
    "gimme $xferserverPublic"
xferserver_expect bad-config-too-few "${xferserverLogin}config /project\n" \
    {error bad\scommand:}
xferserver_expect uv-hash-not-a-hash \
    "${xferserverLogin}pragma uv-hash nothash\n" \
    "!uv-pull-only" "!uv-push-ok" "errors 0"
xferserver_expect ci-lock-not-a-hash \
    [xferserver_lock nothash $xferserverClientA] \
    "!avoid-delta-manifests" "errors 0"
xferserver_expect ci-unlock-too-few "${xferserverLogin}pragma ci-unlock\n" \
    "errors 0"
xferserver_expect client-url-too-few "${xferserverLogin}pragma client-url\n" \
    "errors 0"

# The unversioned catalog is sent once in a reply, and a client that may
# write unversioned files is told so.
xferserver_caps "oy"
xferserver_expect uv-hash-may-push "pragma uv-hash $xferserverAbsent\n" \
    "pragma uv-push-ok"
xferserver_expect uv-hash-twice \
    "pragma uv-hash $xferserverAbsent\npragma uv-hash $xferserverAbsent\n" \
    "pragma uv-push-ok" "errors 0"
test xfer-server-uv-hash-twice-one-answer \
    {[regexp -all {pragma uv-push-ok} $RESULT] == 1}

xferserver_caps "o"
xferserver_expect read-client-url \
    "${xferserverPull}pragma client-url http://example.net/z\n" "errors 0"
test xfer-server-read-client-url-not-recorded \
    {[xferserver_count "config WHERE name GLOB 'sync*example.net*'"] == 0}

# Links to other repositories of the project are given on request, except
# those on the local host.
xferserver_set syncwith:http://localhost:8080/y "{}"
xferserver_expect read-req-links "${xferserverPull}pragma req-links\n" \
    "pragma link http://example.org/x" "!localhost:8080/y"

# The address configuration is given only to a client that may read
# addresses.
xferserver_caps "oe"
xferserver_expect read-address-reqconfig "reqconfig /all\n" "errors 0"

xferserver_caps "gx"
xferserver_expect clone-version-one "${CLIENT_VERSION_CARD}clone 1 1\n" \
    "push " "igot $xferserverFile" "errors 0"
xferserver_expect clone-then-gimme \
    "${CLIENT_VERSION_CARD}clone\ngimme $xferserverFile\n" \
    "file $xferserverFile" "errors 0"
xferserver_expect clone-send-private \
    "${CLIENT_VERSION_CARD}pragma send-private\nclone\n" "push " "errors 0"
xferserver_set uv-sync 1
xferserver_expect clone-uv-sync-after-uv-hash \
    "${CLIENT_VERSION_CARD}pragma uv-hash $xferserverAbsent\nclone 3 1\n" \
    "pragma uv-pull-only"
test xfer-server-clone-uv-sync-one-catalog \
    {[regexp -all {pragma uv-pull-only} $RESULT] == 1}
xferserver_unset uv-sync
xferserver_caps ""

# More check-in locks: a lock on another check-in does not block this
# one, a lock on a check-in that has a child is dropped, and a lock with
# no user name is reported as held by "nobody".
fossil sql -R srv.fossil "SELECT b.uuid FROM blob b, plink p\
   WHERE b.rid=p.pid AND p.cid=(SELECT max(objid) FROM event WHERE type='ci')"
set xferserverParent [string trim $::RESULT]
test xfer-server-setup-parent {[string length $xferserverParent] >= 40}
xferserver_expect ci-lock-on-parent \
    [xferserver_lock $xferserverParent $xferserverClientA] \
    "!ci-lock-fail" "errors 0"
xferserver_expect ci-lock-parent-not-a-leaf \
    [xferserver_lock $xferserverParent $xferserverClientB] \
    "!ci-lock-fail" "errors 0"
xferserver_expect ci-lock-tip \
    [xferserver_lock $xferserverCkin $xferserverClientA] \
    "!ci-lock-fail" "errors 0"
test xfer-server-ci-lock-parent-dropped \
    {[xferserver_count "config WHERE name GLOB 'ci-lock-*'"] == 1}
fossil sql -R srv.fossil "UPDATE config SET value=json_object('clientid',\
   '$xferserverClientA') WHERE name GLOB 'ci-lock-*'"
xferserver_expect ci-lock-held-by-nobody \
    [xferserver_lock $xferserverCkin $xferserverClientB] \
    "pragma ci-lock-fail nobody "
xferserver_unset ci-lock-*

# The TH1 transfer scripts run on the server.  One that fails is reported.
xferserver_set xfer-push-script "set xferserverSeen 1"
xferserver_expect push-script-ok "$xferserverLogin$xferserverPush" "errors 0"
xferserver_set xfer-push-script "error push-script-says-no"
xferserver_expect push-script-fails "$xferserverLogin$xferserverPush" \
    {error push\sscript\sfailed:} "push-script-says-no"
xferserver_unset xfer-push-script
xferserver_set xfer-common-script "error common-script-says-no"
xferserver_expect common-script-fails \
    "$xferserverLogin$xferserverPull$xferserverPush" \
    {error common\sscript\sfailed:} "common-script-says-no"
xferserver_unset xfer-common-script

# A repository with no project code cannot answer a pull or a push.
xferserver_unset project-code
xferserver_send "$xferserverLogin$xferserverPull"
test xfer-server-no-project-code \
    {$CODE == 1 && [string first "missing project code" $RESULT] >= 0}

###############################################################################

test_cleanup
