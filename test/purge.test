#
# Commands that remove content from a repository: "fossil purge", with
# its graveyard, undo and obliterate, and "fossil scrub".  After each the
# repository must still be sound, and an undo must give back exactly what
# was removed.
#

# The first sections run at every level, and the rest need
# -assurance stress.
require_no_open_checkout

test_setup
source [file join $::testfiledir trunk-fixes.tcl]

proc purge_sql {sql {repo .rep.fossil}} {
  return [fossil_sql $sql $repo]
}

proc purge_commit {file content comment args} {
  set new [expr {![file exists $file]}]
  write_file $file $content
  if {$new} {fossil add $file}
  fossil commit -m $comment --no-warnings {*}$args
  return [checkin_hash $comment]
}

# The number of the newest purge event.
proc purge_last_event {{repo .rep.fossil}} {
  return [purge_sql "SELECT max(peid) FROM purgeevent" $repo]
}

proc purge_has {repo hash} {
  return [purge_sql "SELECT count(*) FROM blob WHERE uuid='$hash'
      AND size>=0" $repo]
}

# The number of file and parent links whose artifact is not in the
# repository at all.  repository_state compares the links by hash, which also
# shows a link to the wrong artifact.
proc purge_dangling {repo} {
  return [purge_sql "SELECT (SELECT count(*) FROM mlink
      WHERE fid>0 AND fid NOT IN (SELECT rid FROM blob))
    + (SELECT count(*) FROM plink
      WHERE pid NOT IN (SELECT rid FROM blob)
         OR cid NOT IN (SELECT rid FROM blob))" $repo]
}

###############################################################################
# A trunk of five check-ins, each a new version of one file, so that the
# file is stored as deltas; a branch of two check-ins off the third; and a
# second file that only the branch has.

fossil settings autosync off
set purgeText ""
for {set purgeI 0} {$purgeI < 60} {incr purgeI} {
  append purgeText "line $purgeI of a file that is stored as deltas\n"
}
set purgeTrunk {}
for {set purgeI 1} {$purgeI <= 5} {incr purgeI} {
  append purgeText "version $purgeI\n"
  lappend purgeTrunk [purge_commit a.txt $purgeText purge-trunk-$purgeI]
  set purgeTrunkText($purgeI) $purgeText
}
fossil update [lindex $purgeTrunk 2]
fossil branch new side current
fossil update side
set purgeSide1 [purge_commit a.txt "${purgeTrunkText(3)}on the side\n" \
    purge-side-1]
set purgeSide2 [purge_commit b.txt "a file only the branch has\n" purge-side-2]
set purgeSideB [checkin_file_hash $purgeSide2 b.txt]
fossil update trunk

repository_sound purge-start
set purgeStart [repository_state]
file copy .rep.fossil full.fossil

###############################################################################
# A trial run changes nothing.

fossil purge checkins side --explain
test purge-explain {$CODE == 0}
test_eq purge-explain-no-change [repository_state] $purgeStart
fossil purge checkins side --dry-run
test_eq purge-dry-run-no-change [repository_state] $purgeStart

# Either option may be given twice, or both together, with the same result.
foreach {purgeName purgeArgs} {
  explain-twice  {--explain --explain}
  explain-dry    {--explain --dry-run}
  dry-twice      {--dry-run --dry-run}
} {
  fossil_raw purge checkins side {*}$purgeArgs
  test purge-$purgeName {$CODE == 0 &&
      [string match "*check-in to side*file b.txt*" $RESULT]}
  test_eq purge-$purgeName-no-change [repository_state] $purgeStart
}
fossil purge list
test_eq purge-explain-no-graveyard [string trim $RESULT] ""

###############################################################################
# Purge a branch.  Its check-ins, and the files that only it uses, go;
# everything on trunk can still be read.

fossil purge checkins side
test purge-checkins {$CODE == 0 &&
    [string match "*artifacts purged*" $RESULT]}
test_eq purge-checkins-gone [purge_sql "SELECT count(*) FROM blob
    WHERE uuid IN ('$purgeSide1','$purgeSide2','$purgeSideB')"] 0
test_eq purge-checkins-no-event [purge_sql "SELECT count(*) FROM event
    WHERE comment LIKE 'purge-side-%'"] 0
test_eq purge-checkins-trunk-kept [purge_sql "SELECT count(*) FROM event
    WHERE comment LIKE 'purge-trunk-%'"] 5
repository_sound purge-checkins
for {set purgeI 1} {$purgeI <= 5} {incr purgeI} {
  fossil cat a.txt -r [lindex $purgeTrunk [expr {$purgeI-1}]]
  test_eq purge-checkins-trunk-$purgeI "$RESULT\n" $purgeTrunkText($purgeI)
}
set purgeEvent [purge_last_event]
fossil purge list
test purge-list {[string match "*$purgeEvent on *" $RESULT]}
fossil purge list -l
test purge-list-detail {[string first [string range $purgeSide2 0 9] \
    $RESULT] >= 0}
# "ls" is another name for "list".
fossil purge ls
test purge-ls {[string match "*$purgeEvent on *" $RESULT]}

# The graveyard gives back the content, a delta among it included.
fossil purge cat $purgeSideB
test_eq purge-cat [string trim $RESULT] "a file only the branch has"
fossil purge cat [purge_sql "SELECT uuid FROM purgeitem
    WHERE srcid IS NOT NULL LIMIT 1"]
test purge-cat-delta {$CODE == 0}

# A trial run of the undo restores nothing and keeps the purge.
set purgeBefore [repository_state]
fossil purge undo $purgeEvent --explain
test purge-undo-explain {$CODE == 0}
test_eq purge-undo-explain-no-change [repository_state] $purgeBefore
test_eq purge-undo-explain-event-kept [purge_last_event] $purgeEvent
fossil purge undo $purgeEvent --dry-run
test_eq purge-undo-dry-run-event-kept [purge_last_event] $purgeEvent

# Undo gives back exactly what was there.
fossil purge undo $purgeEvent
test purge-undo {$CODE == 0}
test_eq purge-undo-state [repository_state_diff $purgeStart \
    [repository_state]] ""
repository_sound purge-undo
fossil purge list
test_eq purge-undo-graveyard-empty [string trim $RESULT] ""
fossil cat b.txt -r $purgeSide2
test_eq purge-undo-content [string trim $RESULT] "a file only the branch has"

###############################################################################
# A record number that a purge frees can be given to the next artifact
# stored.  A kept check-in must never take that artifact for its parent,
# before the undo or after it.  The parent is made the newest record by
# storing it last, and the repository is then rebuilt to link them.
set purgeP [lindex $purgeTrunk 3]
set purgeC [lindex $purgeTrunk 4]
fossil init p5.fossil
set purgeAll [purge_sql "SELECT group_concat(uuid,' ') FROM (SELECT uuid
    FROM blob WHERE size>=0 AND uuid<>'$purgeP' ORDER BY rid)" full.fossil]
foreach purgeH [concat $purgeAll [list $purgeP]] {
  fossil artifact $purgeH -R full.fossil art.txt
  fossil test-content-put art.txt -R p5.fossil
}
fossil rebuild p5.fossil
test purge-reuse-setup {[purge_sql "SELECT count(*) FROM plink
    WHERE cid=(SELECT rid FROM blob WHERE uuid='$purgeC')
      AND pid=(SELECT rid FROM blob WHERE uuid='$purgeP')
      AND pid=(SELECT max(rid) FROM blob)" p5.fossil] == 1}
fossil purge artifacts $purgeP -R p5.fossil
write_file other.txt "an artifact stored after the purge\n"
fossil test-content-put other.txt -R p5.fossil
proc purge_parent_of {repo child} {
  return [purge_sql "SELECT group_concat(p.uuid) FROM plink
      JOIN blob p ON p.rid=plink.pid
     WHERE plink.cid=(SELECT rid FROM blob WHERE uuid='$child')" $repo]
}
test purge-reuse-no-false-parent \
    {[purge_parent_of p5.fossil $purgeC] in [list "" $purgeP]}
fossil purge undo [purge_last_event p5.fossil] -R p5.fossil
test purge-reuse-undo {$CODE == 0}
test purge-reuse-undo-no-false-parent \
    {[purge_parent_of p5.fossil $purgeC] in [list "" $purgeP]}

# What is refused.

fossil update side
fossil purge checkins side -expectError
test purge-current-checkout {$CODE != 0 &&
    [string match "*cannot purge the current check-out*" $RESULT]}
# The same when the repository is named with -R from inside the check-out.
fossil purge checkins side -R [file join [pwd] .rep.fossil] -expectError
test purge-current-checkout-repository {$CODE != 0 &&
    [string match "*cannot purge the current check-out*" $RESULT]}
# And when it is named by a symbolic link to it.
if {$::tcl_platform(platform) eq "unix"} {
  file link -symbolic link.fossil [file join [pwd] .rep.fossil]
  fossil purge checkins side -R link.fossil -expectError
  test purge-current-checkout-link {$CODE != 0 &&
      [string match "*cannot purge the current check-out*" $RESULT]}
  file delete link.fossil
}
fossil update trunk
test_eq purge-current-checkout-no-change [repository_state] $purgeStart

fossil purge cat [string repeat 0 40] -expectError
test purge-cat-missing {$CODE != 0}
fossil purge tickets x -expectError
test purge-tickets-not-implemented {$CODE != 0}
fossil purge wiki x -expectError
test purge-wiki-not-implemented {$CODE != 0}
fossil purge frobnicate -expectError
test purge-unknown-subcommand {$CODE != 0}

# Each of these lacks an argument and gets the usage message.
foreach {purgeName purgeArgs} {
  nothing     {}
  cat         {cat}
  checkins    {checkins}
  obliterate  {obliterate --force}
  undo        {undo}
  undo-two    {undo 1 2}
} {
  fossil purge {*}$purgeArgs -expectError
  test purge-usage-$purgeName {$CODE != 0 &&
      [string match "*Usage:*" $RESULT]}
}
test_eq purge-usage-no-change [repository_state] $purgeStart

if {[test_assurance] ne "stress"} {
  test_skip "the tests after the first sections need -assurance stress"
}

###############################################################################
# Purging one file version that a kept version is a delta of, on a copy.
# The kept version is stored whole first and can still be read.

file copy full.fossil p1.fossil
set purgeV2 [checkin_file_hash [lindex $purgeTrunk 1] a.txt]
set purgeV3 [checkin_file_hash [lindex $purgeTrunk 2] a.txt]
test purge-delta-setup {[purge_sql "SELECT count(*) FROM delta
    WHERE srcid=(SELECT rid FROM blob WHERE uuid='$purgeV3')" p1.fossil] > 0}
fossil purge artifacts $purgeV3 -R p1.fossil
test purge-artifact {$CODE == 0}
test_eq purge-artifact-gone [purge_has p1.fossil $purgeV3] 0
fossil artifact $purgeV2 -R p1.fossil
test_eq purge-artifact-neighbour-readable "$RESULT\n" $purgeTrunkText(2)
fossil test-integrity -R p1.fossil
test purge-artifact-integrity {$CODE == 0}
# While it is purged, the check-in that holds it lacks a file, and
# test-missing says so.
fossil test-missing -R p1.fossil -expectError
test purge-artifact-missing-reported {$CODE != 0}

# After the undo the check-ins that hold the file point to it again, and
# the history of the file has every version.
fossil purge undo [purge_last_event p1.fossil] -R p1.fossil
test purge-artifact-undo {$CODE == 0}
test_eq purge-artifact-undo-back [purge_has p1.fossil $purgeV3] 1
test_eq purge-artifact-undo-links [purge_dangling p1.fossil] 0
test_eq purge-artifact-undo-state \
    [repository_state_diff $purgeStart [repository_state p1.fossil]] ""
repository_sound purge-artifact-undo p1.fossil
fossil rebuild p1.fossil
test_eq purge-artifact-rebuild-state \
    [repository_state_diff $purgeStart [repository_state p1.fossil]] ""

# Every version of a file, by name, on another copy.
file copy full.fossil p2.fossil
fossil purge files a.txt -R p2.fossil
test purge-files {$CODE == 0}
test_eq purge-files-gone [purge_sql "SELECT count(*) FROM blob
    WHERE uuid IN ('$purgeV2','$purgeV3')" p2.fossil] 0
fossil purge undo [purge_last_event p2.fossil] -R p2.fossil
test purge-files-undo {$CODE == 0}
test_eq purge-files-undo-back [purge_sql "SELECT count(*) FROM blob
    WHERE uuid IN ('$purgeV2','$purgeV3')" p2.fossil] 2
test_eq purge-files-undo-links [purge_dangling p2.fossil] 0
fossil rebuild p2.fossil
test_eq purge-files-rebuild-state \
    [repository_state_diff $purgeStart [repository_state p2.fossil]] ""

# Purging check-ins takes a repository named with -R, as every command
# can.
file copy full.fossil p3.fossil
fossil_raw purge checkins side --explain -R p3.fossil
test purge-checkins-repository-explain {$CODE == 0}
# The same from a directory that is not in any check-out.
set purgeHere [pwd]
cd [file dirname $purgeHere]
fossil_raw purge checkins side --explain -R [file join $purgeHere p3.fossil]
cd $purgeHere
test purge-checkins-no-checkout-explain {$CODE == 0 &&
    [string first [string range $purgeSide2 0 15] $RESULT] >= 0}
fossil_raw purge checkins side -R p3.fossil
test purge-checkins-repository {$CODE == 0}

# One check-in in the middle of trunk, alone, on a copy.  Its child keeps
# its link to it, and after the undo the history is as it was.  While it is
# purged the child names a parent that is not there, and test-missing says
# so.
file copy full.fossil p4.fossil
set purgeMiddle [lindex $purgeTrunk 3]
fossil purge artifacts $purgeMiddle -R p4.fossil
test purge-middle {$CODE == 0}
test_eq purge-middle-gone [purge_has p4.fossil $purgeMiddle] 0
fossil test-integrity -R p4.fossil
test purge-middle-integrity {$CODE == 0}
fossil test-missing -R p4.fossil -expectError
test purge-middle-missing-reported {$CODE != 0}
fossil timeline -n 20 -R p4.fossil
test purge-middle-timeline {$CODE == 0 &&
    [string match "*purge-trunk-5*" $RESULT] &&
    ![string match "*purge-trunk-4*" $RESULT]}
fossil purge undo [purge_last_event p4.fossil] -R p4.fossil
test purge-middle-undo {$CODE == 0}
test_eq purge-middle-undo-state \
    [repository_state_diff $purgeStart [repository_state p4.fossil]] ""
repository_sound purge-middle-undo p4.fossil

# A ticket change.  The ticket goes with its only change and comes back
# with the undo.
fossil ticket add title "a ticket to purge" status Open -R p4.fossil
set purgeTicket [purge_sql "SELECT uuid FROM blob
    WHERE rid=(SELECT tkt_rid FROM ticketchng)" p4.fossil]
test purge-ticket-setup {[purge_sql "SELECT count(*) FROM ticket
    WHERE title='a ticket to purge'" p4.fossil] == 1}
set purgeBefore [repository_state p4.fossil]
fossil purge artifacts $purgeTicket -R p4.fossil
test purge-ticket {$CODE == 0}
test_eq purge-ticket-gone [purge_sql "SELECT (SELECT count(*) FROM ticket)
    + (SELECT count(*) FROM ticketchng)" p4.fossil] 0
fossil purge undo [purge_last_event p4.fossil] -R p4.fossil
test purge-ticket-undo {$CODE == 0}
test_eq purge-ticket-undo-back [purge_sql "SELECT count(*) FROM ticket
    WHERE title='a ticket to purge'" p4.fossil] 1
test_eq purge-ticket-undo-state \
    [repository_state_diff $purgeBefore [repository_state p4.fossil]] ""

# A repository whose plink table has no baseid column, as one made before
# the 2014-11-28 schema change that was never rebuilt; the column is
# dropped here with SQL.  A purge works on it; a rebuild adds the column,
# and the undo then restores what was purged.
file copy full.fossil p6.fossil
fossil sql -R p6.fossil "ALTER TABLE plink DROP COLUMN baseid"
fossil purge artifacts $purgeMiddle -R p6.fossil
test purge-old-plink {$CODE == 0}
test_eq purge-old-plink-gone [purge_has p6.fossil $purgeMiddle] 0
fossil rebuild p6.fossil
test purge-old-plink-rebuild {$CODE == 0}
fossil purge undo [purge_last_event p6.fossil] -R p6.fossil
test purge-old-plink-undo {$CODE == 0}
test_eq purge-old-plink-undo-back [purge_has p6.fossil $purgeMiddle] 1
test_eq purge-old-plink-undo-state \
    [repository_state_diff $purgeStart [repository_state p6.fossil]] ""
repository_sound purge-old-plink-undo p6.fossil

# "fossil bundle purge" removes the check-ins of a bundle without a
# graveyard: there is no purge event, nothing is said about an undo, and
# importing the bundle brings the branch back.
file copy full.fossil p7.fossil
fossil bundle export side.bundle --branch side -R p7.fossil
test purge-bundle-export {$CODE == 0}
fossil bundle purge side.bundle -R p7.fossil
test purge-bundle {$CODE == 0 && ![string match "*undoable*" $RESULT] &&
    ![string match "*artifacts purged*" $RESULT]}
test_eq purge-bundle-gone [purge_sql "SELECT count(*) FROM blob
    WHERE uuid IN ('$purgeSide1','$purgeSide2','$purgeSideB')" p7.fossil] 0
test_eq purge-bundle-no-graveyard [purge_sql "SELECT count(*)
    FROM sqlite_schema WHERE name IN ('purgeevent','purgeitem')" p7.fossil] 0
fossil test-integrity -R p7.fossil
test purge-bundle-integrity {$CODE == 0}
fossil bundle import side.bundle --publish -R p7.fossil
test purge-bundle-import {$CODE == 0}
test_eq purge-bundle-import-state \
    [repository_state_diff $purgeStart [repository_state p7.fossil]] ""

###############################################################################
# A graveyard that has been damaged with SQL.  Each command stops with a
# message and restores nothing.  In source-loop two items name each other
# as delta source.  In undo-record-zero the hash of an item is already in
# the repository under record number 0; that undo stops with no message.

file copy full.fossil p8.fossil
fossil purge files a.txt -R p8.fossil
set purgeEvent8 [purge_last_event p8.fossil]
set purgeDeltaItem [purge_sql "SELECT uuid FROM purgeitem
    WHERE srcid IS NOT NULL LIMIT 1" p8.fossil]
set purgeWholeItem [purge_sql "SELECT uuid FROM purgeitem
    WHERE srcid IS NULL LIMIT 1" p8.fossil]
test purge-damage-setup {$purgeDeltaItem ne "" && $purgeWholeItem ne ""}
set purgeOtherHash [string repeat a 64]
foreach {purgeName purgeDamage purgeArgs purgeMessage} [list \
  source-gone \
    "DELETE FROM purgeitem WHERE piid=(SELECT srcid FROM purgeitem
       WHERE uuid='$purgeDeltaItem')" \
    [list cat $purgeDeltaItem] \
    "*missing purge-item*" \
  cat-wrong-hash \
    "UPDATE purgeitem SET uuid='$purgeOtherHash'
      WHERE uuid='$purgeWholeItem'" \
    [list cat $purgeOtherHash] \
    "*incorrect artifact hash on $purgeOtherHash*" \
  undo-wrong-hash \
    "UPDATE purgeitem SET uuid='$purgeOtherHash'
      WHERE uuid='$purgeWholeItem'" \
    [list undo $purgeEvent8] \
    "*incorrect hash on $purgeOtherHash*" \
  cat-source-loop \
    "UPDATE purgeitem SET srcid=(SELECT piid FROM purgeitem
       WHERE uuid='$purgeDeltaItem')
      WHERE piid=(SELECT srcid FROM purgeitem
       WHERE uuid='$purgeDeltaItem')" \
    [list cat $purgeDeltaItem] \
    "*is part of a delta cycle*" \
  undo-record-zero \
    "PRAGMA ignore_check_constraints=1;
     INSERT INTO blob(rid,rcvid,size,uuid)
      VALUES(0,0,1,'$purgeWholeItem')" \
    [list undo $purgeEvent8] \
    "*" \
] {
  file copy -force p8.fossil damaged.fossil
  fossil sql -R damaged.fossil $purgeDamage
  set purgeBefore [repository_state damaged.fossil]
  fossil_raw purge {*}$purgeArgs -R damaged.fossil
  test purge-damage-$purgeName {$CODE == 1 &&
      [string match $purgeMessage $RESULT]} \
      [trunk_mark $purgeName cat-source-loop]
  test_eq purge-damage-$purgeName-no-change [repository_state damaged.fossil] \
      $purgeBefore
  test_eq purge-damage-$purgeName-event-kept \
      [purge_last_event damaged.fossil] $purgeEvent8
}

# An item with no record number is restored under a new one.
file copy -force p8.fossil damaged.fossil
fossil sql -R damaged.fossil "UPDATE purgeitem SET orid=NULL"
fossil purge undo $purgeEvent8 -R damaged.fossil
test purge-undo-no-record-number {$CODE == 0}
fossil rebuild damaged.fossil
test_eq purge-undo-no-record-number-state \
    [repository_state_diff $purgeStart [repository_state damaged.fossil]] ""
repository_sound purge-undo-no-record-number damaged.fossil

# A check-in is purged and its child, which is kept, then loses its
# content.  The undo restores the purged check-in and does not link the
# child to it.
file copy -force full.fossil damaged.fossil
fossil purge artifacts $purgeP -R damaged.fossil
fossil sql -R damaged.fossil "UPDATE blob SET size=-1, content=NULL
    WHERE uuid='$purgeC'"
fossil purge undo [purge_last_event damaged.fossil] -R damaged.fossil
test purge-undo-child-without-content {$CODE == 0}
test_eq purge-undo-child-without-content-back \
    [purge_has damaged.fossil $purgeP] 1
test_eq purge-undo-child-without-content-not-linked \
    [purge_parent_of damaged.fossil $purgeC] ""

###############################################################################
# Obliterate.  Asked first, unless --force; afterwards the purge cannot
# be undone.

fossil purge checkins side
set purgeEvent [purge_last_event]

# The error for a missing item names the item that is missing.
fossil_raw purge cat $purgeSideB [string repeat 0 40]
test purge-cat-second-missing {$CODE != 0 &&
    [string match "*a file only the branch has*" $RESULT]}
test purge-cat-second-missing-named \
    {[string first [string repeat 0 40] $RESULT] >= 0}

fossil_raw -input "n\n" purge obliterate $purgeEvent
test purge-obliterate-declined {$CODE == 1}
test_eq purge-obliterate-declined-kept [purge_last_event] $purgeEvent
fossil_raw -input "y\n" purge obliterate $purgeEvent
test purge-obliterate {$CODE == 0}
test_eq purge-obliterate-gone [purge_sql "SELECT count(*) FROM purgeitem"] 0
# A capital Y is a yes too.
fossil purge artifacts $purgeMiddle -R p4.fossil
set purgeEvent4 [purge_last_event p4.fossil]
fossil_raw -input "Y\n" purge obliterate $purgeEvent4 -R p4.fossil
test purge-obliterate-capital {$CODE == 0}
test_eq purge-obliterate-capital-gone [purge_sql "SELECT count(*)
    FROM purgeevent WHERE peid=$purgeEvent4" p4.fossil] 0
fossil purge obliterate $purgeEvent --force -expectError
test purge-obliterate-again {$CODE != 0 &&
    [string match "*no such purge event*" $RESULT]}
repository_sound purge-obliterate

# An undo of a purge that does not exist is refused, as an obliterate of
# one is.
set purgeBefore [repository_state]
fossil_raw purge undo $purgeEvent
test purge-undo-missing-event {$CODE == 1}
test_eq purge-undo-missing-event-no-change [repository_state] $purgeBefore

# A repository that has never had a purge has no graveyard tables.  Undo
# and obliterate are refused there as for any unknown purge, the list is
# empty, and a scrub of private content has nothing to take from it.
fossil init nograve.fossil
foreach {purgeName purgeArgs} {
  undo        {undo 1}
  obliterate  {obliterate 1 --force}
} {
  fossil_raw purge {*}$purgeArgs -R nograve.fossil
  test purge-no-graveyard-$purgeName {$CODE == 1 &&
      [string match "*no such purge event: 1*" $RESULT]}
}
fossil purge list -R nograve.fossil
test_eq purge-no-graveyard-list [string trim $RESULT] ""
fossil scrub --private --force nograve.fossil
test purge-no-graveyard-scrub {$CODE == 0}
test_eq purge-no-graveyard-none-made [purge_sql "SELECT count(*)
    FROM sqlite_schema WHERE name IN ('purgeevent','purgeitem')" \
    nograve.fossil] 0

###############################################################################
# A purge is local.  A clone made afterwards lacks what was purged; a
# pull from a repository that still holds it brings it back.

fossil clone .rep.fossil c1.fossil
test purge-clone {$CODE == 0}
test_eq purge-clone-lacks [purge_sql "SELECT count(*) FROM blob
    WHERE uuid='$purgeSide2'" c1.fossil] 0
fossil pull [file join [pwd] full.fossil]
test purge-pull-back {$CODE == 0}
test_eq purge-pull-back-state \
    [repository_state_diff $purgeStart [repository_state]] ""
repository_sound purge-pull-back

###############################################################################
# Scrub.  A private branch, a password and a purge in the graveyard, then
# each kind of scrub on its own copy.

set purgeSecretText ""
for {set purgeI 0} {$purgeI < 60} {incr purgeI} {
  append purgeSecretText "line $purgeI of private content\n"
}
set purgeSecret [purge_commit secret.txt $purgeSecretText purge-secret \
    --private --branch secret]
set purgeSecretFile [checkin_file_hash $purgeSecret secret.txt]
fossil update trunk
fossil user new scrubuser scrub@example.invalid hunter2
set purgePublic [purge_sql "SELECT group_concat(uuid,' ') FROM (SELECT uuid
    FROM blob WHERE size>=0 AND rid NOT IN private ORDER BY uuid)"]
foreach purgeCopy {s1 s2 s3 s4 s5 s7} {
  file copy .rep.fossil $purgeCopy.fossil
}
proc purge_public {repo} {
  return [purge_sql "SELECT group_concat(uuid,' ') FROM (SELECT uuid
      FROM blob WHERE size>=0 AND rid NOT IN private ORDER BY uuid)" $repo]
}
test purge-scrub-setup {[password_count s1.fossil] > 0 &&
    [purge_has s1.fossil $purgeSecret] == 1}

# Asked first; "n" changes nothing.
fossil_raw -input "n\n" scrub s1.fossil
test purge-scrub-declined {$CODE == 1}
test purge-scrub-declined-kept {[password_count s1.fossil] > 0}

# By default only passwords go.
fossil scrub --force s1.fossil
test purge-scrub {$CODE == 0}
test_eq purge-scrub-passwords [password_count s1.fossil] 0
test_eq purge-scrub-keeps-private [purge_has s1.fossil $purgeSecret] 1
test_eq purge-scrub-keeps-public [purge_public s1.fossil] $purgePublic
repository_sound purge-scrub s1.fossil

# --private removes the private branch and nothing else.
fossil scrub --private --force s2.fossil
test purge-scrub-private {$CODE == 0}
test_eq purge-scrub-private-gone [purge_has s2.fossil $purgeSecret] 0
test_eq purge-scrub-private-file-gone [purge_has s2.fossil $purgeSecretFile] 0
test_eq purge-scrub-private-none-left [purge_sql "SELECT count(*)
    FROM private" s2.fossil] 0
test_eq purge-scrub-private-no-event [purge_sql "SELECT count(*) FROM event
    WHERE comment='purge-secret'" s2.fossil] 0
test_eq purge-scrub-private-keeps-public [purge_public s2.fossil] $purgePublic
test purge-scrub-private-keeps-passwords {[password_count s2.fossil] > 0}
repository_sound purge-scrub-private s2.fossil

# A private branch that was purged before the scrub is in the graveyard.
fossil purge artifacts $purgeSecret $purgeSecretFile -R s3.fossil
test purge-scrub-graveyard-setup {$CODE == 0 &&
    [purge_has s3.fossil $purgeSecret] == 0}
# The detailed list marks each private item with a P.
fossil purge list -l -R s3.fossil
test purge-list-private-mark {[regexp -line \
    "^ +\\d+ [string range $purgeSecret 0 15] +P +\\d+ " $RESULT]}
# Undo, on a copy, gives the private branch back, still private.
file copy s3.fossil s8.fossil
fossil purge undo [purge_last_event s8.fossil] -R s8.fossil
test purge-undo-private {$CODE == 0}
test_eq purge-undo-private-state \
    [repository_state_diff [repository_state s7.fossil] \
        [repository_state s8.fossil]] ""
test_eq purge-undo-private-still-private [purge_sql "SELECT count(*)
    FROM private JOIN blob USING(rid)
   WHERE uuid IN ('$purgeSecret','$purgeSecretFile')" s8.fossil] 2
repository_sound purge-undo-private s8.fossil
fossil scrub --private --force s3.fossil
test purge-scrub-graveyard {$CODE == 0}
# The private branch does not survive in the graveyard, so neither
# "purge cat" nor "purge undo" can bring it back.
test_eq purge-scrub-private-graveyard [purge_sql "SELECT count(*)
    FROM purgeitem WHERE isPrivate" s3.fossil] 0
fossil_raw purge cat $purgeSecretFile -R s3.fossil
test purge-scrub-private-graveyard-cat {$CODE == 1}

# A public item in the graveyard that is stored as a delta from a private
# one is kept and can still be read.  "fossil publish" leaves such deltas:
# the older version of a file is stored as a delta from the newer, and
# only the older is published.
fossil update secret
set purgeSecret2 [purge_commit secret.txt "${purgeSecretText}one more\n" \
    purge-secret-2]
set purgeSecretFile2 [checkin_file_hash $purgeSecret2 secret.txt]
fossil update trunk
file copy .rep.fossil s6.fossil
fossil publish $purgeSecret -R s6.fossil
test purge-scrub-publish {$CODE == 0}
test purge-scrub-public-from-private {[purge_sql "SELECT count(*) FROM delta
    WHERE rid=(SELECT rid FROM blob WHERE uuid='$purgeSecretFile')
      AND srcid=(SELECT rid FROM blob WHERE uuid='$purgeSecretFile2')
      AND rid NOT IN private AND srcid IN private" s6.fossil] == 1}
fossil purge artifacts $purgeSecretFile $purgeSecretFile2 -R s6.fossil
test purge-scrub-delta-in-graveyard {[purge_sql "SELECT count(*)
    FROM purgeitem a JOIN purgeitem b ON a.srcid=b.piid
   WHERE NOT a.isPrivate AND b.isPrivate" s6.fossil] == 1}
fossil scrub --private --force s6.fossil
test purge-scrub-delta {$CODE == 0}
test_eq purge-scrub-delta-private-gone [purge_sql "SELECT count(*)
    FROM purgeitem WHERE isPrivate" s6.fossil] 0
fossil purge cat $purgeSecretFile -R s6.fossil
test_eq purge-scrub-delta-public-kept $RESULT [string trim $purgeSecretText]

# --verily removes the graveyard too, and the private branch.
fossil purge artifacts $purgeSecret $purgeSecretFile -R s4.fossil
fossil scrub --verily --force s4.fossil
test purge-scrub-verily {$CODE == 0}
test_eq purge-scrub-verily-no-graveyard [purge_sql "SELECT count(*)
    FROM sqlite_schema WHERE name='purgeitem'" s4.fossil] 0
test_eq purge-scrub-verily-passwords [password_count s4.fossil] 0
test_eq purge-scrub-verily-keeps-public [purge_public s4.fossil] $purgePublic
repository_sound purge-scrub-verily s4.fossil

# A scrubbed repository still clones.
fossil clone s2.fossil c2.fossil
test purge-scrub-clone {$CODE == 0}
test_eq purge-scrub-clone-public [purge_public c2.fossil] $purgePublic

###############################################################################
# repack changes how content is stored, never what it is.

fossil repack s5.fossil
test purge-repack {$CODE == 0}
test_eq purge-repack-same \
    [repository_state_diff [repository_state s7.fossil] \
        [repository_state s5.fossil]] ""
test_eq purge-repack-public [purge_public s5.fossil] $purgePublic
test_eq purge-repack-private [purge_has s5.fossil $purgeSecret] 1
repository_sound purge-repack s5.fossil

###############################################################################
# A delta manifest names its baseline.  A purge of the baseline alone is
# refused; with the delta manifest it goes through, and the undo restores
# both.

fossil settings forbid-delta-manifests off
set purgeBase [lindex $purgeTrunk 4]
set purgeDeltaM [purge_commit a.txt "${purgeTrunkText(5)}one more line\n" \
    purge-delta-manifest --delta]
test purge-baseline-setup {[purge_sql "SELECT count(*) FROM plink
    WHERE cid=(SELECT rid FROM blob WHERE uuid='$purgeDeltaM')
      AND baseid=(SELECT rid FROM blob WHERE uuid='$purgeBase')"] == 1}
fossil update [lindex $purgeTrunk 3]
set purgeBefore [repository_state]
fossil_raw purge artifacts $purgeBase
test purge-baseline-alone-refused {$CODE ne "0" &&
    [string match "*attempt to purge a baseline manifest*" $RESULT]}
test_eq purge-baseline-alone-no-change [repository_state] $purgeBefore
fossil purge artifacts $purgeBase $purgeDeltaM
test purge-baseline-with-delta {$CODE == 0}
test_eq purge-baseline-with-delta-gone [purge_sql "SELECT count(*) FROM blob
    WHERE uuid IN ('$purgeBase','$purgeDeltaM')"] 0
fossil purge undo [purge_last_event]
test purge-baseline-undo {$CODE == 0}
test_eq purge-baseline-undo-state \
    [repository_state_diff $purgeBefore [repository_state]] ""
repository_sound purge-baseline-undo

###############################################################################

test_cleanup
