th1_cases {
  th1-lsearch-1 {lsearch} \
      {TH_ERROR: wrong # args: should be "lsearch list string"}
  th1-lsearch-2 {lsearch a} \
      {TH_ERROR: wrong # args: should be "lsearch list string"}
  th1-lsearch-3 {lsearch a a a} \
      {TH_ERROR: wrong # args: should be "lsearch list string"}
  th1-lsearch-4 {lsearch {a b c} a} 0
  th1-lsearch-5 {lsearch {a b c} b} 1
  th1-lsearch-6 {lsearch {a b c} c} 2
  th1-lsearch-7 {lsearch {a b c} d} -1
  th1-lsearch-8 {lsearch {a b c} aa} -1
  th1-lsearch-9 {lsearch {aa b c} a} -1
}

###############################################################################

fossil test-th-eval "lsearch \"\{aa b c\" a"
test th1-lsearch-10 {$RESULT eq "TH_ERROR: Expected list, got: \"\{aa b c\""}

###############################################################################

th1_cases {
  th1-glob-match-1 {glob_match} \
      {TH_ERROR: wrong # args: should be "glob_match ?-one? ?--? patternList string"}
  th1-glob-match-2 {glob_match -one} \
      {TH_ERROR: wrong # args: should be "glob_match ?-one? ?--? patternList string"}
  th1-glob-match-3 {glob_match --} \
      {TH_ERROR: wrong # args: should be "glob_match ?-one? ?--? patternList string"}
  th1-glob-match-4 {glob_match -one --} \
      {TH_ERROR: wrong # args: should be "glob_match ?-one? ?--? patternList string"}
  th1-glob-match-5 {glob_match -one -- 1} \
      {TH_ERROR: wrong # args: should be "glob_match ?-one? ?--? patternList string"}
  th1-glob-match-6 {glob_match -one -- 1 2 3} \
      {TH_ERROR: wrong # args: should be "glob_match ?-one? ?--? patternList string"}
  th1-glob-match-7 {list [glob_match a A] [glob_match A a]} {0 0}
  th1-glob-match-8 {list [glob_match a,b a] [glob_match a,b b]} {1 2}
  th1-glob-match-9 {list [glob_match -one a,b a] [glob_match -one a,b b]} {0 0}
  th1-glob-match-10 {list [glob_match -one a,b a,b] [glob_match -one a b,a]} {1 0}
  th1-glob-match-11 {list [glob_match a*c abc] [glob_match abc a*c]} {1 0}
  th1-glob-match-12 {list [glob_match a?c abc] [glob_match abc a?c]} {1 0}
  th1-glob-match-13 {list [glob_match {a[bd]c} abc] [glob_match abc {a[bd]c}]} {1 0}
}

###############################################################################

th1_cases {
  th1-string-is-1 {string is} \
      {TH_ERROR: wrong # args: should be "string is class string"}
  th1-string-is-2 {string is something} \
      {TH_ERROR: wrong # args: should be "string is class string"}
  th1-string-is-3 {string is not something else} \
      {TH_ERROR: wrong # args: should be "string is class string"}
  th1-string-is-4 {string is other 123} \
      {TH_ERROR: Expected alnum, double, integer, list, or tainted, got: other}
  th1-string-is-5 {string is alnum 123} 1
  th1-string-is-6 {string is alnum abc} 1
  th1-string-is-7 {string is alnum 123abc} 1
  th1-string-is-8 {string is alnum abc123} 1
  th1-string-is-9 {string is alnum _abc123} 0
  th1-string-is-10 {string is alnum abc.123} 0
  th1-string-is-11 {string is alnum abc123_} 0
  th1-string-is-12 {string is list ""} 1
  th1-string-is-13 {string is list 1} 1
  th1-string-is-14 {string is list "1 2 3"} 1
  th1-string-is-15 {string is list "\{"} 0
  th1-string-is-16 {string is list "1 2 3 \{"} 0
  th1-string-is-17 {string is list "1 2 3 \{\}"} 1
  th1-string-is-18 {string is list "1 2 3 \{\{\}"} 0
  th1-string-is-19 {string is double 123} 1
  th1-string-is-20 {string is double 123.456} 1
  th1-string-is-21 {string is double 123abc} 0
  th1-string-is-22 {string is double 123_456} 0
  th1-string-is-23 {string is integer 123} 1
  th1-string-is-24 {string is integer 123.456} 0
  th1-string-is-25 {string is integer 123abc} 0
  th1-string-is-26 {string is integer 0b11001001} 1
  th1-string-is-27 {string is integer 0b11001002} 0
  th1-string-is-28 {string is integer 0o777} 1
  th1-string-is-29 {string is integer 0o778} 0
  th1-string-is-30 {string is integer 0xC0DEF00D} 1
  th1-string-is-31 {string is integer 0xC0DEF00Z} 0
}

###############################################################################

th1_cases {
  th1-string-index-1 {string index "" -1} {}
  th1-string-index-2 {string index "" 0} {}
  th1-string-index-3 {string index "" 1} {}
  th1-string-index-4 {string index "" 2} {}
  th1-string-index-5 {string index "" end} {}
  th1-string-index-6 {string index A -1} {}
  th1-string-index-7 {string index A 0} A
  th1-string-index-8 {string index A 1} {}
  th1-string-index-9 {string index A 2} {}
  th1-string-index-10 {string index A end} A
  th1-string-index-11 {string index ABC -1} {}
  th1-string-index-12 {string index ABC 0} A
  th1-string-index-13 {string index ABC 1} B
  th1-string-index-14 {string index ABC 2} C
  th1-string-index-15 {string index ABC end} C
}

