#
# What fossil puts on an ssh command line.  Nothing here connects to
# another machine: "ssh" is a copy of standin/log-args.sh, which writes
# down its arguments and exits.  A command that has the --ssh-command
# option is given the script with it.  The other commands find the
# script first on the PATH.
#
# Whatever follows the host on an ssh command line is joined into one
# string by ssh and parsed again by the login shell on the server, so
# quoting for the local shell does not protect it.  These tests require
# that a value with a character special to a shell never reaches ssh,
# and that ordinary values reach it unchanged.
#

require_no_open_checkout

if {$::tcl_platform(platform) eq "windows"} {
  test_skip "the stand-in for ssh is a shell script"
}

test_setup
source [file join $::testfiledir trunk-fixes.tcl]

set sshDir [file join [pwd] ssh-standin]
file mkdir $sshDir
set sshStub [test_standin log-args.sh [file join $sshDir ssh]]
set sshLog [file join [pwd] ssh-args.txt]
set ::env(ARGS_LOG) $sshLog
set sshSavedPath $::env(PATH)
set ::env(PATH) "$sshDir:$::env(PATH)"

# The stand-in must be what "ssh" means from here on.  If it is not, run
# nothing that could start the real one.
if {[lindex [auto_execok ssh] 0] ne $sshStub} {
  set ::env(PATH) $sshSavedPath
  test_skip "cannot put a stand-in for ssh first on the PATH"
}

# Run fossil with the arguments given.  Sets RESULT to everything it
# printed and sshArgs to the arguments the stand-in was given, one per
# line inside <>, or to an empty string if it was not run.
proc ssh_run {args} {
  global sshArgs sshLog
  file delete $sshLog
  fossil_raw {*}$args
  set sshArgs ""
  if {[file exists $sshLog]} {
    set sshArgs [read_file $sshLog]
  }
}
proc ssh_clone {url} {
  file delete ssh-clone.fossil
  ssh_run clone --ssh-command $::sshStub $url ssh-clone.fossil
}

###############################################################################
# Ordinary URLs reach ssh, with "--" before the host and the path as one
# argument.

ssh_clone ssh://hh/dir/repo.fossil
test ssh-clone-plain \
    {[holds_strings $sshArgs \
        [list "<-->\n<hh>\n" "<test-http>\n<dir/repo.fossil>"]]}
ssh_clone ssh://uu@hh:2222/dir/repo.fossil
test ssh-clone-user-port \
    {[holds_strings $sshArgs [list "<-p>\n<2222>\n" "<-->\n<uu@hh>\n"]]}
ssh_clone "ssh://hh/dir/a-b_c.d,e=f@g/repo.fossil"
test ssh-clone-punctuation \
    {[string first "<dir/a-b_c.d,e=f@g/repo.fossil>" $sshArgs] >= 0}
ssh_clone "ssh://hh/repo.fossil?fossil=/opt/bin/fossil"
test ssh-clone-fossil-parameter \
    {[string first "<hh>\n</opt/bin/fossil>\n<test-http>" $sshArgs] >= 0}

# A path that begins with "~" is for the server to expand, so it goes to
# the server as it is.
ssh_clone ssh://hh/~/repo.fossil
test ssh-clone-tilde {[string first "<~/repo.fossil>" $sshArgs] >= 0}

###############################################################################
# A path or a fossil= value with a character special to a shell is
# refused, and ssh is not run.

foreach {sshName sshUrl} {
  semicolon   ssh://hh/a;b.fossil
  space       ssh://hh/a%20b.fossil
  dollar      ssh://hh/$HOME/b.fossil
  ampersand   ssh://hh/a%26b.fossil
  backquote   ssh://hh/a%60b.fossil
  pipe        ssh://hh/a|b.fossil
  parenthesis ssh://hh/a(b).fossil
  redirect    ssh://hh/a>b.fossil
} {
  ssh_clone $sshUrl
  test ssh-clone-refused-$sshName \
      {$sshArgs eq "" && [string first "special to the shell" $RESULT] >= 0}
}
foreach {sshName sshUrl} {
  semicolon   ssh://hh/repo.fossil?fossil=a;b/fossil
  dollar      ssh://hh/repo.fossil?fossil=$HOME/bin/fossil
  other       ssh://hh/repo.fossil?fossil=/bin/other
} {
  ssh_clone $sshUrl
  test ssh-clone-fossil-refused-$sshName \
      {$sshArgs eq "" && [string first "unsafe command" $RESULT] >= 0}
}

###############################################################################
# "fossil ui HOST:REPO" refuses such a repository name, and puts "--"
# before the host.

ssh_run ui --nobrowser hh:dir/repo.fossil
test ssh-ui-plain \
    {[holds_strings $sshArgs [list "<-->\n<hh>\n" "<dir/repo.fossil>"]]}
ssh_run ui --nobrowser "hh:dir/a;b.fossil"
test ssh-ui-refused-semicolon \
    {$sshArgs eq "" && [string first "special to the shell" $RESULT] >= 0}
ssh_run ui --nobrowser "hh:dir/a b.fossil"
test ssh-ui-refused-space \
    {$sshArgs eq "" && [string first "special to the shell" $RESULT] >= 0}
ssh_run ui --nobrowser -- "-x@hh:dir/repo.fossil"
test ssh-ui-user-with-dash {[string first "<-->\n<-x@hh>\n" $sshArgs] >= 0}

###############################################################################
# "fossil patch push" and "fossil patch pull" put "--" before the host.

write_file ssh-file.txt "one\n"
fossil add ssh-file.txt
ssh_run patch push -- "-x@hh:dir"
test ssh-patch-push-user-with-dash \
    {[string first "<-->\n<-x@hh>\n" $sshArgs] >= 0}
ssh_run patch pull -- "-x@hh:dir"
test ssh-patch-pull-user-with-dash \
    {[string first "<-->\n<-x@hh>\n" $sshArgs] >= 0}

###############################################################################
# An argument that begins with "~" is quoted, so that the shell does not
# replace it with a home directory.

ssh_run test-escaped-arg ~ ~root/x
test ssh-escaped-tilde \
    {[holds_strings $RESULT {{argv[2] = [~]} {argv[2] = [~root/x]}}]}

###############################################################################
# "sync --all" with two remotes: the default one answers every request
# with a redirect to an ssh: URL, and the second, a repository file, has
# an artifact that the local repository lacks, so the sync makes a
# second pass.  The redirect is refused on each pass and ssh is not run.
# Known bug: a refused redirect replaces the URL of the remote, so the
# second pass connects to the ssh: URL.

proc ssh_redirect {chan request} {
  puts -nonewline $chan "HTTP/1.1 302 Found\r\nLocation: ssh://hh/r.fossil\r\n"
  puts -nonewline $chan "Content-Length: 0\r\nConnection: close\r\n\r\n"
}
fossil new ssh-local.fossil
file copy -force ssh-local.fossil ssh-other.fossil
write_file ssh-page.txt "page\n"
fossil wiki create SshPage ssh-page.txt -R ssh-other.fossil
set sshPort [test_listen ssh_redirect]
fossil remote http://127.0.0.1:$sshPort/x -R ssh-local.fossil
fossil remote add other [file join [pwd] ssh-other.fossil] -R ssh-local.fossil
ssh_run sync --all -R ssh-local.fossil
test_listen_stop
test ssh-sync-all-refused-redirect {$sshArgs eq "" &&
    [string first "cannot redirect to ssh://hh/r.fossil" $RESULT] >= 0} \
    knownBug

set ::env(PATH) $sshSavedPath
unset ::env(ARGS_LOG)
test_cleanup
