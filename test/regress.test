#
# Tests of single faults that have no better home.
#

require_no_open_checkout

test_setup

write_file a.txt "a\n"
fossil add a.txt
fossil commit -m "regress-c1"

###############################################################################
# "fossil test-dir-list" on an empty directory, and on one that does not
# exist.

file mkdir empty-directory
fossil test-dir-list empty-directory
test regress-dir-list-empty {$CODE == 0}
fossil test-dir-list no-such-directory
test regress-dir-list-missing {$CODE == 0}

###############################################################################
# "fossil test-xfer" answers a request, with no robot captcha.

write_file request.txt $CLIENT_VERSION_CARD
fossil test-xfer request.txt
test regress-test-xfer {$CODE == 0}
test_match regress-test-xfer-reply $RESULT {# timestamp}

###############################################################################
# A branch name shorter than "date:" is looked up without reading past its
# end.  A fault here shows only in a build with run-time checking.

fossil branch new br trunk
fossil update br
test regress-short-branch-name {$CODE == 0}
fossil update trunk

###############################################################################
# An HTML comment or an HR tag followed by spaces and no newline.  The
# Markdown translator must not copy a byte from past the end of its input,
# so the output has no NUL.

foreach {regressName regressText} {
  hr       "<hr>  "
  comment  "<!-- x -->  "
  quoted   "> <hr>  "
} {
  write_file md-$regressName.md $regressText
  fossil_raw test-markdown-render md-$regressName.md
  test regress-markdown-html-block-$regressName \
       {$CODE == 0 && [string first \x00 $RESULT] < 0}
}

###############################################################################
# "fossil import --svn" with property blocks whose lengths do not fit the
# dump file: a block too short for its end marker, negative lengths and
# oversized ones.  Each import must stop with an error about the svn-dump
# data, and a sound dump must import.

proc regress_svn_rev {number props} {
  set length [string length $props]
  set head "Revision-number: $number\nProp-content-length: $length\n"
  return "${head}Content-length: $length\n\n$props\n"
}

proc regress_svn_props {props} {
  set block ""
  foreach {name value} $props {
    append block "K [string length $name]\n$name\n"
    append block "V [string length $value]\n$value\n"
  }
  return "${block}PROPS-END\n"
}

# Each import has a time limit of 60 seconds, so that an endless loop
# fails the test.
set regressSvnHead "SVN-fs-dump-format-version: 2\n\nUUID: 0\n\n"
foreach {regressName regressProps} {
  short-block     "abcd\n"
  negative-delete "D -6\nxxxxxxxxxxxxxxxx\nPROPS-END\n"
  oversized-key   "K 5000\nab\nV 1\nx\nPROPS-END\n"
  oversized-value "K 2\nab\nV 99999\nx\nPROPS-END\n"
  negative-value  "K 2\nab\nV -40\nx\nPROPS-END\n"
} {
  write_file svn-$regressName.dump \
      $regressSvnHead[regress_svn_rev 0 $regressProps]
  fossil_raw -seconds 60 import --svn svn-$regressName.fossil \
      svn-$regressName.dump
  test regress-svn-import-$regressName \
       {$CODE == 1 && [string match "*svn-dump data*" $RESULT]}
}

set regressSvnDate {svn:date 2026-01-01T00:00:00.000000Z}
set regressSvnSound $regressSvnHead
append regressSvnSound [regress_svn_rev 0 [regress_svn_props $regressSvnDate]]
append regressSvnSound [regress_svn_rev 1 [regress_svn_props \
    [concat {svn:log first svn:author dan} $regressSvnDate]]]
write_file svn-sound.dump $regressSvnSound
fossil import --svn svn-sound.fossil svn-sound.dump
test regress-svn-import-sound {$CODE == 0}

###############################################################################
# Two more malformed property blocks for "fossil import --svn": one with a
# NUL byte in it, and one whose length is negative.  Each is refused.

write_file svn-nul-in-block.dump \
    $regressSvnHead[regress_svn_rev 0 "K\x00\x00\x00PROPS-END\n"]
set regressSvnNegative "Revision-number: 0\nProp-content-length: -5\n"
append regressSvnNegative "Content-length: 10\n\nPROPS-END\n\n"
write_file svn-negative-block.dump $regressSvnHead$regressSvnNegative
foreach regressName {nul-in-block negative-block} {
  fossil_raw -seconds 60 import --svn svn-$regressName.fossil \
      svn-$regressName.dump
  test regress-svn-import-$regressName \
       {$CODE == 1 && [string match "*svn-dump data format broken*" $RESULT]}
}

###############################################################################
# A Markdown header that holds an HTML comment is read within its bounds
# when its id is made.  A fault here shows only in a build with run-time
# checking.

write_file md-header.md "intro\n\n# a <!-- -->\n"
fossil test-markdown-render md-header.md
test regress-markdown-header-comment \
     {$CODE == 0 && [string first {<h1 id="a">} $RESULT] >= 0}

###############################################################################
# The name of a file in a sibling directory, relative to the current
# directory.  A fault here shows only in a build with run-time checking.

file mkdir rel/b rel/c-with-a-longer-name/sub
fossil test-relative-name --chdir rel/b ../c-with-a-longer-name/sub/file.txt
test regress-relative-name-sibling \
     {$CODE == 0
      && [string trim $RESULT] eq "../c-with-a-longer-name/sub/file.txt"}
fossil test-relative-name --slash --chdir rel/b ../c-with-a-longer-name/sub/
test regress-relative-name-sibling-slash \
     {$CODE == 0 && [string trim $RESULT] eq "../c-with-a-longer-name/sub/"}

###############################################################################
# The names of the files in a merge conflict are put into the
# gmerge-command as they are, inside the double quotes that the setting
# has around them.  For a name with a double quote, a dollar sign or a
# backquote the tool is left out, with a warning, and the conflict stays
# marked in the file.  The merge tool here is
# standin/log-args.sh, which records its arguments and resolves nothing.

if {$::tcl_platform(platform) ne "windows"} {
  set regressTop [pwd]
  set regressTool [test_standin log-args.sh [file join $regressTop gmerge.sh]]
  set regressToolLog [file join $regressTop gmerge-args.txt]
  set ::env(ARGS_LOG) $regressToolLog
  foreach {regressName regressFile regressRuns} {
    plain      plain.txt    1
    space      {sp ace.txt} 1
    quote      {a" "b.txt}  0
    dollar     {a$b.txt}    0
    backquote  {a`x`b.txt}  0
  } {
    file mkdir gmerge-$regressName
    cd gmerge-$regressName
    fossil init r.fossil
    fossil open r.fossil --nested
    write_file $regressFile "one\ntwo\nthree\n"
    fossil add $regressFile
    fossil commit -m base --no-warnings
    write_file $regressFile "one\nTWO-branch\nthree\n"
    fossil commit -m branch --branch br --no-warnings
    fossil update trunk
    write_file $regressFile "one\nTWO-trunk\nthree\n"
    fossil commit -m trunk --no-warnings
    fossil settings gmerge-command \
        "$regressTool \"%baseline\" \"%original\" \"%merge\" \"%output\""
    file delete $regressToolLog
    fossil_raw merge br
    set regressArgs 0
    if {[file exists $regressToolLog]} {
      set regressArgs \
          [llength [split [string trim [read_file $regressToolLog]] \n]]
    }
    set regressMarked \
        [expr {[string first "<<<<<<<" [read_file $regressFile]] >= 0}]
    set regressWarned \
        [expr {[string first "not running the gmerge-command" $RESULT] >= 0}]
    test regress-gmerge-$regressName \
         {$CODE == 0 && $regressMarked && $regressArgs == 4*$regressRuns
          && $regressWarned != $regressRuns}
    fossil close --force
    cd $regressTop
  }
  unset ::env(ARGS_LOG)
}

###############################################################################
# A port number above 65535 in a URL is refused with an error.

fossil remote http://example.invalid:99999999999/x -expectError
test regress-url-port-too-large {$CODE != 0
    && [string match "*port number too large*" $RESULT]}
fossil remote http://example.invalid:65535/x
test regress-url-port-largest {$CODE == 0}
fossil remote off

###############################################################################
# "fossil ticket add" and "ticket set" with plain fields, a field to
# append to, and a private field.  The change artifact lists the cards that
# append before the cards that assign, and the private value is stored
# concealed.

fossil ticket add title "A ticket" status Open comment first
test regress-ticket-add {$CODE == 0}
fossil sql "SELECT tkt_uuid FROM ticket WHERE title='A ticket'"
set regressTkt [string trim $RESULT]
fossil ticket set $regressTkt status Closed +comment " second" \
    private_contact someone@example.org
test regress-ticket-set {$CODE == 0}
fossil sql "SELECT status, comment FROM ticket WHERE tkt_uuid='$regressTkt'"
test_eq regress-ticket-set-fields [string trim $RESULT] "Closed|first second"
fossil sql "SELECT private_contact FROM ticket WHERE tkt_uuid='$regressTkt'"
test regress-ticket-private-concealed \
    {[string trim $RESULT] ne "" && ![string match "*someone*" $RESULT]}
fossil sql "SELECT uuid FROM blob, event WHERE objid=rid AND type='t'
            ORDER BY mtime DESC LIMIT 1"
fossil artifact [string trim $RESULT]
set regressTktCards [regexp -all -inline -line {^J \+?\S+} $RESULT]
test regress-ticket-append-first \
    {[lindex $regressTktCards 0] eq "J +comment"
     && "J status" in $regressTktCards
     && "J private_contact" in $regressTktCards}

###############################################################################
# A push into a clone that already holds a wiki attachment succeeds, and
# the clone keeps one attachment row for it.

write_file attach.txt "attached\n"
write_file wiki.txt "wiki\n"
fossil wiki create AttachPage wiki.txt
fossil attachment add AttachPage attach.txt
fossil clone .rep.fossil regress-attach-clone.fossil
fossil push regress-attach-clone.fossil --once
test regress-push-held-attachment {$CODE == 0
    && ![string match "*UNIQUE constraint*" $RESULT]}
fossil sql -R regress-attach-clone.fossil \
    "SELECT count(*) FROM attachment WHERE target='AttachPage'"
test_eq regress-push-held-attachment-rows [string trim $RESULT] 1

###############################################################################
# The TH1 command styleHeader run from the command line writes the page
# header, whatever the robot-restrict setting.

foreach {regressName regressRobot} {unset {} list timelineX,diff all *} {
  fossil settings robot-restrict $regressRobot
  fossil_raw test-th-eval --open-config {styleHeader {Page Title}}
  test regress-styleheader-cli-$regressName \
      {$CODE == 0 && [string match "*<title>*: Page Title</title>*" $RESULT]}
}
fossil settings robot-restrict ""

###############################################################################
# A base URL given with --baseurl and no path, with or without a slash after
# the host, serves pages at the root.  A fault here shows only in a build
# with run-time checking.

write_file baseurl-req.txt "GET /robots.txt HTTP/1.1\r\nHost: x\r\n\r\n"
foreach {regressName regressUrl} {bare https://x slash https://x/} {
  fossil_raw http .rep.fossil --in baseurl-req.txt --baseurl $regressUrl
  test regress-baseurl-no-path-$regressName \
      {$CODE == 0 && [string match "HTTP/1.0 200*" $RESULT]}
}

test_cleanup
