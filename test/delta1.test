############################################################################
#
# Tests of the delta mechanism.
#

test_setup ""

# Use generated text of several kinds as the basis for this test:
# ASCII text, a large file, long lines, CR/LF line endings, UTF-8 text
# in Greek, in Chinese and in four-byte characters, UTF-16 text in both
# byte orders, a file of four lines and a line that has no newline.
#
# For each text, write the text intact to "./t1".  Make
# some random changes in "./t2".  Then call test-delta on the
# two files to make sure that deltas between these two files
# work properly.
#
set fourbyte {}
for {set i 0} {$i<40} {incr i} {
  set char [binary format H6c f0a080 [expr {0x80+$i}]]
  append fourbyte [string repeat $char [expr {$i%7+3}]]\n
}
set greek [fixed_word_lines 200 0x3b1]
set utf16 [lmap c [split \ufeff$greek ""] {scan $c %c}]
set inputs [list \
  ascii     [fixed_word_lines 400] \
  large     [fixed_word_lines 5000] \
  longlines [fixed_word_lines 60 97 150] \
  crlf      [string map [list \n \r\n] [fixed_word_lines 100]] \
  repeats   [fixed_word_lines 4000 97 1 1] \
  utf8      [encoding convertto utf-8 $greek] \
  cjk       [encoding convertto utf-8 [fixed_word_lines 200 0x4e00]] \
  fourbyte  $fourbyte \
  utf16le   [binary format s* $utf16] \
  utf16be   [binary format S* $utf16] \
  short     [fixed_word_lines 4] \
  oneline   "one line that has no newline" \
]
foreach {base f1} $inputs {
  write_file t1 $f1
  for {set i 0} {$i<100} {incr i} {
    write_file t2 [random_changes $f1 1 1 0 0.1]
    fossil test-delta t1 t2
    test delta-$base-$i-1 {[normalize_result]=="ok"}
    write_file t2 [random_changes $f1 1 1 0 0.2]
    fossil test-delta t1 t2
    test delta-$base-$i-2 {[normalize_result]=="ok"}
    write_file t2 [random_changes $f1 1 1 0 0.4]
    fossil test-delta t1 t2
    test delta-$base-$i-3 {[normalize_result]=="ok"}
  }
}

set empties { "" "" "" a a "" }
set i 0
foreach {f1 f2} $empties {
  incr i
  write_file t1 $f1
  write_file t2 $f2
  fossil test-delta t1 t2
  test delta-empty-$i {[normalize_result]=="ok"}
}
###############################################################################

test_cleanup
