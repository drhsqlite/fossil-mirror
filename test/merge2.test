############################################################################
#
# Tests of the "3-way-merge" command on generated text of several
# kinds: ASCII text, a large file, long lines, CR/LF line endings,
# UTF-8 text in Greek, in Chinese and in four-byte characters, a file
# of four lines and a line that has no newline.
#

test_setup ""

set fourbyte {}
for {set i 0} {$i<40} {incr i} {
  set char [binary format H6c f0a080 [expr {0x80+$i}]]
  append fourbyte [string repeat $char [expr {$i%7+3}]]\n
}
set inputs [list \
  ascii     [fixed_word_lines 400] \
  large     [fixed_word_lines 5000] \
  longlines [fixed_word_lines 60 97 150] \
  crlf      [string map [list \n \r\n] [fixed_word_lines 100]] \
  repeats   [fixed_word_lines 4000 97 1 1] \
  utf8      [encoding convertto utf-8 [fixed_word_lines 200 0x3b1]] \
  cjk       [encoding convertto utf-8 [fixed_word_lines 200 0x4e00]] \
  fourbyte  $fourbyte \
  short     [fixed_word_lines 4] \
  oneline   "one line that has no newline" \
]
foreach {base f1} $inputs {
  write_file t1 $f1
  set ntrials [test_trials \
      [expr {$base eq "large" || $base eq "repeats"}]]
  for {set i 0} {$i<$ntrials} {incr i} {
    expr {srand($i*2)}
    write_file t2 [set f2 [random_changes $f1 2 4 0 0.1]]
    expr {srand($i*2+1)}
    write_file t3 [set f3 [random_changes $f1 2 4 2 0.1]]
    expr {srand($i*2+1)}
    write_file t23 [random_changes $f2 2 4 2 0.1]
    expr {srand($i*2)}
    write_file t32 [random_changes $f3 2 4 0 0.1]
    fossil 3-way-merge t1 t2 t3 a23
    if {[regexp {<<<<< BEGIN MERGE CONFLICT:} [read_file a23]]} continue
    test merge-$base-$i-23 {[same_file a23 t23]}
    fossil 3-way-merge t1 t3 t2 a32
    test merge-$base-$i-32 {[same_file a32 t32]}
  }
}

###############################################################################

test_cleanup
